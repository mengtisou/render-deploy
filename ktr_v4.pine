//@version=6
indicator("KTR v4", overlay=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════
// KTR v4 — KTR ONLY + ❖ FILTERS (v3 + Export without the filters: ktr_v3_export.pine)
// KTR ONLY (the SMC 2026 ICT part is removed so the
// script fits TradingView's size limit; the full version stays in
// smc_2026_ict_ktr_v3_export.pine)
//
// ⓪ KTR MODULE  — daily OP/MLP + KTR±1/2/3 levels (0.4% steps),
//                 yellow/red trend candles, blue alert diamonds,
//                 ❖ entry confirmations. Toggle whole module on/off.
// ⓪b ❖ TRADES   — every KTR ❖ entry becomes a trade: TP 200 or 100 pts
//                 / SL 100 pts, at the ❖ close or as a pending order
//                 ± offset (e.g. 40 pts). WIN / LOSS marked on the
//                 chart and counted in the dashboard, with the test
//                 period, spread (W / L for 0 / 0.18 / 0.22 / 0.30 side
//                 by side) and an optional daily limit.
//                 Option: skip the next ❖ after 2 SL in a row (both numbers editable).
//                 Option: 1 ❖ trade per session, or after an SL wait for the next session.
// ⓪c PROP FIRM  — runs the ❖ trades on a prop account ($10K default):
//                 daily / max loss, target, min days, Phase 1 → 2 →
//                 Funded, and blocks ❖ trades that could break a limit.
// ⓪ OP SIDE FILTER (option, default Off) — price above the daily open (OP) → only BUY ❖,
//                 price below OP → only SELL ❖. Set in the KTR group.
// ⓪ ❖ FILTERS (options, default Off) — higher-TF trend (1H / 4H), rejection wick on the
//                 ❖ candle, and 'wait 1 candle: the next candle must hold'.
//                 Order flow filter (buy / sell volume pressure must agree with the ❖)
//                 and strong one-way trend filter (ADX: no ❖ against a strong trend).
// 🔬 FILTER REPORT — runs the v3 ❖ (no filters) in the background and shows which ❖
//                 the filters removed and how those would have ended (W / L).
// 🧪 BREAKDOWN    — W / L and R of all ❖ trades by diamond type, side, session, nth of
//                 day, 1H trend, order flow, ADX and location vs OP (one hover).
// ◇ DIAMOND TYPES — reversal / continuation / micro-pullback ❖ can be switched off one by one.
// ⚖ BREAK-EVEN    — option: SL moves to entry (+ lock) after +X pts.
// ⓪ ❖ ON 5 MIN (option, default Off) — the blue / red diamond still comes from the
//                 chart candles (e.g. 15m), the ❖ confirms on the 1 / 3 / 5 min
//                 candles after it and the trade starts at that candle's close.
// ⓪d NEWS FILTER — high-impact news times (auto NFP + your own list):
//                 no new ❖ trade from 45 min BEFORE until 15 min AFTER the
//                 release (both editable), pending orders inside that window
//                 are cancelled, the window is shaded on the chart, and
//                 Win / Loss is counted Normal / Before / Window / After news.
//                 Speeches (Fed chair, testimony …) have their own shorter window, and
//                 "just before the window" you can cancel pending orders only, or also
//                 close the open trades (no TP / SL can hit inside the window).
// ⓪e MON – FRI   — Win / Loss + win rate for Mon Tue Wed Thu Fri, a running
//                 total Mon → Fri, "this week so far" and the average.
// ⓪f MONTH WEEKS — Win / Loss + win rate for Week 1 (day 1–7), Week 2 (8–14),
//                 Week 3 (15–21), Week 4 (22–end), with the average per month.
// ⓪g DASHBOARD ROWS — every row added in ⓪d / ⓪e / ⓪f has its own show / hide box.
// ⓪i ❖ OF THE DAY — Win / Loss + avg for the 1st, 2nd, 3rd and 4th+ ❖ trade of each
//                 day, "only the first N ❖ a day" totals, and a day log with the dates.
// 📆 PER MONTH   — W / L, pts, R and $ for every month (+ 🎯 / ⛔ days).
// ⛔ / 🎯 → NEXT DAY — W / L of the 1st and 2nd ❖ on the day after a ⛔ loss-limit
//                 day and after a 🎯 target day, with the dates.
//
// NOTE: Boys Buying / Bullishness histograms live in separate pane
// scripts (keep them added alongside this one). A single overlay
// script cannot host its own sub-panes.
// ══════════════════════════════════════════════════════════════════

// ── GROUPS ──
var string G0  = "⓪ KTR MODULE  Levels · Diamonds"
var string G0b = "⓪b KTR ❖ TRADES  TP · SL · Win / Loss"
var string G0c = "⓪c PROP FIRM MODE  account rules"
var string G0d = "⓪d NEWS FILTER  high impact · no-trade window"
var string G0e = "⓪e DASHBOARD ROWS  show / hide (Mon–Fri · month weeks · news)"
var string G9  = "⑨ Display"
var string G10 = "⑩ Alerts"

// ── ⚡ MASTER SWITCHES ──
i_showDash = input.bool(true, "Show dashboard table", group="⚡ MASTER SWITCHES")

// ── KTR INPUTS ──
i_ktrOn    = input.bool (true,  "Enable KTR module",              group=G0)
i_ktrLvls  = input.bool (true,  "Show levels  OP · MLP · KTR±",   group=G0)
i_ktrStep  = input.float(0.40,  "Step % of daily open",           group=G0, step=0.05)
i_ktrBelow = input.bool (true,  "Show KTR-1/-2/-3 below open",    group=G0)
i_ktrMLP   = input.bool (true,  "Show MLP (prev day close)",      group=G0)
i_ktrDia   = input.bool (true,  "Show diamonds + entry ❖",        group=G0)
i_ktrSTf   = input.float(2.0,   "Supertrend factor",              group=G0, step=0.5)
i_ktrSTa   = input.int  (10,    "Supertrend ATR length",          group=G0)
i_ktrRsiOn = input.bool (true,  "RSI context filter",             group=G0)
i_ktrRsiLo = input.float(35,    "Buy zone: RSI was below",        group=G0)
i_ktrRsiHi = input.float(65,    "Sell zone: RSI was above",       group=G0)
i_ktrCool  = input.int  (3,     "Min bars between alerts",        group=G0, minval=0)
i_ktrWin   = input.int  (12,    "Entry ❖ confirm window (bars)",  group=G0, minval=1)
i_ktrLtf   = input.string("Off (chart candles)", "Entry ❖ confirm on lower TF", group=G0,
     options=["Off (chart candles)", "1 min", "3 min", "5 min"],
     tooltip="Off = the ❖ confirms on the chart's own candles (normal).\n5 min (or 1 / 3 min) = the blue / red diamond still comes from the chart candles (e.g. 15m), then the ❖ waits for the first 5-minute candle AFTER the diamond candle that confirms: the 5m trend (same Supertrend settings) flips your way, or a 5m candle closes above the diamond candle's high (BUY) / below its low (SELL). Boys volume and the OP side filter are checked on that 5m candle. The ❖ is drawn on the chart candle that holds it and the trade starts at that 5m candle's close; the rest of that chart candle is checked first on the next candle, so a fast TP / SL is not missed.\nThe confirm window still counts chart candles. Works only when the chart timeframe is higher than the one picked (15m chart + 5 min), otherwise it acts like Off. TradingView loads a limited number of lower-timeframe candles (about 100K on most plans): older chart history without 5m data gets no ❖ — the dashboard ❖ Period row shows from when it starts.")
i_tRev     = input.bool (true,  "Trade ❖ from REVERSAL diamonds",          group=G0,
     tooltip="Each ❖ belongs to the diamond that started it:\nREVERSAL = counter-trend exhaustion (stretched RSI or a fresh 12-candle low / high).\nCONTINUATION = a pullback against the slow trend that fails.\nMICRO = 2+ small counter candles inside the trend, then a thrust back.\nUntick a type to stop its ❖ (the diamond still shows). The 🧪 Breakdown row shows which type wins.")
i_tCon     = input.bool (true,  "Trade ❖ from CONTINUATION diamonds",      group=G0)
i_tMic     = input.bool (true,  "Trade ❖ from MICRO-PULLBACK diamonds",    group=G0)
i_ktrCont  = input.bool (true,  "Continuation signals (trend pullbacks)", group=G0,
     tooltip="Also fire alerts + ❖ when a pullback against the bigger trend fails — e.g. SELL ❖ at a weak bounce inside a downtrend. Uses a softer RSI gate (45/55) since pullbacks rarely reach 35/65.")
i_kMA      = input.bool (true,  "Show 30MA line",                 group=G0)
i_kMALen   = input.int  (30,    "MA length",                      group=G0)
i_kPiv     = input.bool (true,  "Show Pivot 01 (swing high)",     group=G0)
i_kPivLen  = input.int  (10,    "Pivot swing length",             group=G0)
i_ktrVolC  = input.bool (true,  "❖ needs above-average volume (Boys confirm)", group=G0,
     tooltip="CRAZII philosophy: follow the Big Boys. The entry ❖ only prints when the confirming candle's volume is above its 20-bar average — institutional participation, not a thin drift.")
i_ktrVolM  = input.float(1.0,   "Min relative volume for ❖",      group=G0, step=0.1)
i_ktrOpF   = input.string("Off", "OP side filter  (below OP → only SELL · above OP → only BUY)", group=G0,
     options=["Off", "On — ❖ entries only", "On — diamonds and ❖"],
     tooltip="OP = the daily open line. The side is decided by the CLOSE of the candle (price = close vs OP). Equal to OP = neither side.\nOff: no filter.\nOn — ❖ entries only: a BUY ❖ is allowed only when price is above OP, a SELL ❖ only when price is below OP. The blue / red diamonds still show, and a ❖ that is on the wrong side waits inside its confirm window until price is on the right side.\nOn — diamonds and ❖: the diamonds follow the same rule too (a blocked diamond does not use the 'min bars between alerts').\nTrades and statistics follow the ❖, so you can compare Off and On.")
i_kHtf     = input.string("Off", "❖ only with the higher-TF trend",  group=G0,
     options=["Off", "1H", "4H"],
     tooltip="BUY ❖ only while the 1H (or 4H) KTR trend is up, SELL ❖ only while it is down. The trend is the same Supertrend as the yellow / red candles, taken from the LAST CLOSED 1H / 4H candle (no repaint). A ❖ against it waits inside its confirm window until the trend agrees. Stops BUY ❖ from a short spike inside a clear down move (and the other way round).")
i_kWick    = input.bool (false, "Skip ❖ on a rejection candle (big wick against it)", group=G0,
     tooltip="BUY ❖: skipped if the candle's upper wick (high − close) is bigger than the % below of the candle's range — price was pushed up and already rejected. SELL ❖: the lower wick (close − low). The ❖ waits inside its confirm window for a cleaner candle. With 'Entry ❖ confirm on lower TF' the 5m ❖ candle is checked.")
i_kWickPct = input.int  (40,    "Max wick against the ❖ (% of candle)", group=G0, minval=5, maxval=95, step=5)
i_kHold    = input.bool (false, "Wait 1 candle: next candle must hold",  group=G0,
     tooltip="The ❖ is not traded on its own candle. It counts on the NEXT candle only if that candle closes above the middle of the ❖ candle (BUY) / below it (SELL); the trade starts at that next candle's close. A last-minute spike that is rejected right away is filtered out. Only for chart-candle ❖ (not with 'confirm on lower TF').")
i_kOfOn    = input.bool (false, "❖ needs order flow on its side",     group=G0,
     tooltip="Order flow = buying volume − selling volume of the last 'Order flow: delta lookback bars' candles (⑨ Display, 10), in % of all volume (the same number as the Order flow candle colouring). BUY ❖ only when it is at least +X %, SELL ❖ only when it is at most −X %. A ❖ without flow on its side (often a manipulation spike or a thin move) waits inside its confirm window. Note: OANDA gold has tick volume, not real exchange volume — the split into buy / sell is estimated from where each candle closes.")
i_kOfMin   = input.int  (10,    "Min order flow for the ❖ (%)",       group=G0, minval=0, maxval=80, step=5)
i_kAdxOn   = input.bool (false, "No ❖ against a strong one-way trend (ADX)", group=G0,
     tooltip="ADX measures how strong the trend is (not its direction); DI+ / DI− give the direction. When ADX ≥ the level below, the market runs one way: a BUY ❖ is skipped while DI− > DI+ (strong down move) and a SELL ❖ while DI+ > DI− (strong up move). ❖ WITH the strong trend are still taken. Below the level (ranging / two-way market) nothing is blocked.")
i_kAdxMin  = input.int  (25,    "Strong trend: ADX at least",         group=G0, minval=10, maxval=60)
i_volLen   = input.int  (20,    "Pane: Boys relative volume length", group=G0)
i_bullLen  = input.int  (14,    "Pane: Bullishness pressure length", group=G0)

// ── KTR ❖ TRADE INPUTS ──
i_kTrOn    = input.bool  (true,  "Track every ❖ entry as a trade",   group=G0b,
     tooltip="Each KTR entry ❖ becomes a trade (see Entry below). WIN = TP touched first, LOSS = SL touched first. Only the KTR ❖ counts here, SMC signals are not used.")
i_kEntry   = input.string("Pending LIMIT  (BUY −pts · SELL +pts)", "Entry",                    group=G0b,
     options=["At ❖ close", "Pending LIMIT  (BUY −pts · SELL +pts)", "Pending STOP  (BUY +pts · SELL −pts)"],
     tooltip="At ❖ close = trade starts at the ❖ candle's close.\nPending LIMIT = wait for a better price: BUY at ❖ close − offset, SELL at ❖ close + offset.\nPending STOP = wait for a breakout: BUY at ❖ close + offset, SELL at ❖ close − offset.\nA pending order only counts as a WIN / LOSS signal once price reaches it. If it is not reached in time it is 'missed' and not counted.")
i_kOffPts  = input.float (20,    "Pending offset (points)",           group=G0b, minval=0, step=5)
i_kExp     = input.int   (10,    "Pending expires after (candles)",   group=G0b, minval=1,
     tooltip="If price does not reach the pending entry within this many candles after the ❖, the order is cancelled and counted as 'missed' (not a win, not a loss).")
i_kRun     = input.string("200 pts away", "Pending also cancelled when price runs", group=G0b,
     options=["Candles only", "100 pts away", "200 pts away"],
     tooltip="Cancel the pending order ('missed') as soon as price moves this far away from the pending price without filling it — e.g. BUY LIMIT and price rallies 100 / 200 pts above it. The candle limit above still applies too, whichever comes first. If one candle both fills the order and runs away, it counts as filled.")
i_kTpPts   = input.float (200.0, "TP points",                         group=G0b, options=[200.0, 100.0])
i_kTpLon   = input.int   (0,     "London TP (pts, 0 = same as TP)",   group=G0b, minval=0, step=50,
     tooltip="Own TP for ❖ that print in the London session (session times below), e.g. 100 = take +100 pts in London, the normal TP everywhere else. SL stays the same. 0 = same TP as all trades. Compare with London unticked (no London trades) to see which is better.")
i_kSlPts   = input.float (100,   "SL points",                         group=G0b, minval=1, step=10)
i_kPtVal   = input.float (0.10,  "1 point = price",                   group=G0b, minval=0.00001, step=0.01,
     tooltip="XAUUSD: 0.10 → TP 200 pts = $20.00, SL 100 pts = $10.00. Set 0.01 if your broker counts gold points on the 2nd decimal (200 pts = $2.00). Set 1 to use plain price.")
i_kOne     = input.bool  (false, "One trade at a time",               group=G0b,
     tooltip="OFF: every ❖ gets its own trade and its own WIN / LOSS, even while an earlier one is still open. ON: a ❖ that prints while a trade is open or a pending order is waiting is skipped.")
i_kBoth    = input.string("Loss", "TP and SL hit on the same candle", group=G0b, options=["Loss","Win"],
     tooltip="One candle can touch both levels and the chart can't tell which came first. Loss = conservative.")
i_kSpr     = input.float (0.22,  "Spread  (ask − bid price)",         group=G0b, options=[0.0, 0.18, 0.22, 0.30],
     tooltip="Ask − bid, e.g. bid 4285.17 / ask 4285.35 = 0.18. Chart prices are bid: BUY opens on the ask (bid + spread) and its TP / SL are hit on the bid; SELL opens on the bid and its TP / SL are hit on the ask. So the spread changes which trades win or lose. This spread is the one drawn on the chart and shown in the main Win / Loss rows.")
i_kSprCmp  = input.bool  (true,  "Dashboard: Win / Loss for every spread", group=G0b,
     tooltip="Runs every ❖ also with spread 0 / 0.18 / 0.22 / 0.30 in the background (nothing extra drawn) and shows each result in its own dashboard row, so you don't have to switch. ● marks the spread picked above.")
i_sesOn    = input.bool  (true,  "Dashboard: Win / Loss per session", group=G0b,
     tooltip="Each ❖ trade counts in the session where it went live (filled). Where sessions overlap, New York wins over London and London over Asia; trades outside all three count as 'Other'. Uses the spread picked above (●). Turn single sessions ON / OFF with the tick boxes below.")
i_sesAOn   = input.bool  (true,  "Asia",                              group=G0b, inline="sesA")
i_sesAsia  = input.session("0000-0700", "",                           group=G0b, inline="sesA",
     tooltip="Untick a session = OFF: no ❖ trades in it. A ❖ that prints in an OFF session is skipped, and a pending order that would fill in an OFF session is cancelled. The dashboard still shows every session and marks the OFF ones. Tick it again to turn it back ON.")
i_sesLOn   = input.bool  (true,  "London",                            group=G0b, inline="sesL")
i_sesLon   = input.session("0700-1200", "",                           group=G0b, inline="sesL")
i_sesNOn   = input.bool  (true,  "New York",                          group=G0b, inline="sesN")
i_sesNy    = input.session("1200-2100", "",                           group=G0b, inline="sesN")
i_sesOOn   = input.bool  (true,  "Other hours (outside the 3 sessions)", group=G0b)
i_sesTz    = input.string("UTC", "Session times are in",              group=G0b,
     options=["UTC", "GMT+7", "GMT+8", "Europe/London", "America/New_York"],
     tooltip="Defaults in UTC: Asia 00:00–07:00, London 07:00–12:00, New York 12:00–21:00 (= 07:00–14:00, 14:00–19:00, 19:00–04:00 in UTC+7). London and New York open 1 hour later in winter (daylight saving) — change the hours then if you want.")
i_kSesLim  = input.string("Off", "Per session",                        group=G0b,
     options=["Off", "1 ❖ trade per session", "After an SL wait for the next session"],
     tooltip="Sessions = Asia / London / New York / Other hours above (a new day also starts a new session).\n1 ❖ trade per session: only the first ❖ of each session is traded; every later ❖ in that session is skipped, WIN or LOSS — wait for the next session. A pending order that is cancelled before it fills (missed) does not use up the session, so the next ❖ in it can still be taken.\nAfter an SL wait for the next session: ❖ are traded as normal until a trade hits SL; then the rest of that session is skipped (pending orders placed in it are cancelled) and trading starts again with the first ❖ of the next session.\nThe session of a ❖ = the candle it prints on. Trades already open keep running to their own TP / SL. Each spread counts on its own. Skipped ❖ get a grey label and are counted in the session rows' hover.")
i_kDayOn   = input.bool  (true,  "Daily limit",                       group=G0b,
     tooltip="Stop for the day once the day's closed ❖ trades reach the profit target or the loss limit: no new ❖ trades and pending orders are cancelled until the next daily candle. Trades already open still run to their own TP / SL.")
i_kDayTp   = input.float (400,   "Daily profit target (points)",      group=G0b, minval=1, step=50)
i_kDaySl   = input.float (300,   "Daily loss limit (points)",         group=G0b, minval=1, step=50)
i_kBeOn    = input.bool  (false, "Break-even: move SL after +X pts",  group=G0b,
     tooltip="Once a live trade has been at least +X pts in profit (checked at the close of each candle, on the price it can exit at), its SL moves to the entry + 'lock' pts. If price then comes back to it, the trade ends at that price: not a LOSS, counted as 'closed early' (BE) with its pts. TP stays the same. Compare ❖ Net with this ON and OFF.")
i_kBePts   = input.float (100,   "Break-even after + (pts)",          group=G0b, minval=10, step=10)
i_kBeLock  = input.float (0,     "Break-even: lock in (pts)",         group=G0b, minval=0, step=10,
     tooltip="0 = SL exactly at the entry price (BUY: the ask you paid). 20 = SL at entry + 20 pts, so a BE exit still makes +20.")
i_kSkOn    = input.bool  (false, "Skip ❖ after SL in a row",          group=G0b,
     tooltip="ON: after this many SL (LOSS) in a row, the next ❖ is skipped (not traded), then trading goes on with the ❖ after it. Example 2 / 1: 1st ❖ LOSS, 2nd ❖ LOSS → 3rd ❖ skipped → 4th ❖ traded.\nA WIN resets the count; missed pending orders and trades closed early don't change it. After the skip the count starts again from 0.\nThe decision is made when the ❖ prints: a ❖ that comes while the 2nd trade is still open is taken (its SL is not known yet).\nOnly a ❖ that would have been traded is skipped (not one already skipped by the daily limit, session OFF, news, prop limits, one-trade-at-a-time or the hedging rule). Skipped ❖ get a grey 'skip' label and show in the Day log. Each spread counts on its own.")
i_kSkN     = input.int   (2,     "SL in a row before the skip",       group=G0b, minval=1, maxval=10)
i_kSkM     = input.int   (1,     "❖ to skip after that",              group=G0b, minval=1, maxval=10)
i_kSkDay   = input.bool  (true,  "SL in a row: count within the same day only", group=G0b,
     tooltip="ON: the count (and a skip still waiting) starts again at the new daily candle (same day as OP). OFF: losses at the end of one day and the start of the next count together.")
i_kZones   = input.bool  (true,  "Show TP / SL zones",                group=G0b)
i_kWLlab   = input.bool  (true,  "Show WIN / LOSS labels",            group=G0b)
i_kPendLab = input.bool  (true,  "Show pending orders  (BUY / SELL LIMIT · filled · missed)", group=G0b)
i_kDayLab  = input.bool  (true,  "Show DAY TARGET / DAY STOP labels", group=G0b)
i_wdOn     = input.bool  (true,  "Mon – Fri: day rows  (Mon … Fri, running total Σ)", group=G0e,
     tooltip="One row per weekday with W / L, win rate and points, and a running total Σ from Monday up to that day. Also 'This week' (so far) and the Mon – Fri average win rate. A trade counts on the weekday it went live, in the time zone chosen under 'Session times are in'. Trades that go live on Sat / Sun are not in these rows. Uses the spread picked above (●).")

// ── PROP FIRM MODE (runs on the ❖ trades above) ──
i_pfOn     = input.bool  (false, "Prop firm mode",                    group=G0c,
     tooltip="Runs the ❖ trades on a prop firm account: balance in $, daily loss, max loss, profit target and minimum trading days, Phase 1 → Phase 2 → Funded. With 'Block' on, any ❖ that could break a limit is not taken. Defaults = 2-Step Flexi 10K: target 10% (Step 1) / 5% (Step 2), max total loss 12%, daily loss 5% (set 0 if your account has no daily loss limit), 3 trading days — check your own account's rules, firms change them.")
i_pfAcc    = input.float (10000, "Account size ($)",                  group=G0c, minval=100, step=1000)
i_pfLot    = input.float (0.10,  "Lot size per trade",                group=G0c, minval=0.01, step=0.01,
     tooltip="XAUUSD 1 lot = 100 oz. 0.10 lot: SL 100 pts (10.00 price) = −$100 = 1% of 10K, TP 200 pts = +$200.")
i_pfOz     = input.float (100,   "Contract size (oz per lot)",        group=G0c, minval=1)
i_pfComm   = input.float (0,     "Commission $ per lot (round turn)", group=G0c, minval=0, step=1)
i_pfT1     = input.float (10,    "Phase 1 profit target %",           group=G0c, minval=0.1, step=0.5)
i_pfT2     = input.float (5,     "Phase 2 profit target %  (0 = 1-step)", group=G0c, minval=0, step=0.5)
i_pfDay    = input.float (5,     "Max daily loss %  (0 = none)",      group=G0c, minval=0, step=0.5,
     tooltip="0 = the account has no daily loss limit. Counted from the smaller of the account size and the balance at the start of the day, with open trades at their worst price of the candle (equity) — safe for both ways firms count it.")
i_pfMax    = input.float (12,    "Max overall loss %",                group=G0c, minval=0.1, step=0.5,
     tooltip="Static: equity may never go below account size − this %.")
i_pfMinD   = input.int   (3,     "Min trading days per phase",        group=G0c, minval=0)
i_pfGuard  = input.bool  (true,  "Block ❖ trades that could break a limit", group=G0c,
     tooltip="Before each ❖: today's loss + the risk of all open / pending trades + this trade's SL must stay inside the daily and max loss (minus the buffer). Otherwise the ❖ is skipped ('blocked'). Off = take every ❖ and see if the account would fail.")
i_pfBuf    = input.float (0.5,   "Safety buffer before a limit (%)",  group=G0c, minval=0, step=0.1)
i_pfHedge  = input.string("Allow (hedge)", "Opposite ❖ while a trade is open", group=G0c,
     options=["Allow (hedge)", "Skip it (no hedging)", "Close open trade, take the new ❖"],
     tooltip="A BUY is open and a SELL ❖ confirms (or the other way round). Holding a BUY and a SELL on the same symbol at the same time is hedging — some prop firms allow it inside one account, some don't, and the rule can differ between challenge and funded: check your firm's rules.\nAllow = both trades run.\nSkip = the opposite ❖ is not taken, and a pending order that would fill against an open trade is cancelled.\nClose = the open trade is closed at the ❖ candle's close ('closed early', + or − pts, not a WIN / LOSS) and the new ❖ is taken; opposite pending orders are cancelled.")
i_pfLab    = input.bool  (true,  "Show PASSED / FUNDED / FAILED / STOPPED labels", group=G0c)

// ── ⓪d NEWS FILTER ──
i_nwOn     = input.bool  (true,  "News filter ON  (no ❖ trade around high-impact news)", group=G0d,
     tooltip="ON: no new ❖ trade from 'No trade BEFORE news' minutes before a news time until 'Trade again AFTER news' minutes after it. A ❖ printed inside that window is skipped, and a pending order that is still waiting when the window starts is cancelled. Trades that are already open keep running to their own TP / SL.\nOFF: nothing is blocked, but the dashboard still shows how the trades did before / during / after news, so you can compare ON and OFF.")
i_nwBef    = input.int   (45,    "No trade BEFORE news (min)",        group=G0d, minval=0)
i_nwAft    = input.int   (15,    "Trade again AFTER news (min)",      group=G0d, minval=0,
     tooltip="Trading is allowed again this many minutes after the release time. Tip: for FOMC the press conference starts 30 min after the decision, so the default list has a second 'FOMC presser' line.")
i_nwSpMin  = input.int   (10,    "Speeches: minutes BEFORE and AFTER  (0 = same as news)", group=G0d, minval=0,
     tooltip="Fed chair speeches, testimony … listed in 'Speeches list' below. The no-trade window is this many minutes before AND after the speech. 0 = use the same minutes as news.")
i_nwAct    = input.string("Cancel pending orders — open trades stay (holding is allowed)", "Just before the window starts", group=G0d,
     options=["Cancel pending orders — open trades stay (holding is allowed)", "+ close the open trades — no TP / SL can hit inside the window", "Close EVERYTHING + cancel all pending orders (no holding)"],
     tooltip="What happens to the trades when a news / speech window starts (news filter ON):\n1) Cancel pending orders only. Trades that are already open keep running and can hit TP / SL inside the window.\n2) Also close every open trade at the open of the first candle of the window (BUY on the bid, SELL on the ask). It counts as 'closed early': its points are in Net, but it is not a Win or a Loss.\n3) Same as 2 here: this indicator only knows the ❖ trades, so there is nothing else on the account to close.\nOn 30m / 1H charts the window may start inside a candle, then the close happens at that candle's open.")
i_nwNFP    = input.bool  (true,  "Auto: NFP  (1st Friday of the month, 08:30 New York)", group=G0d,
     tooltip="Adds every first-Friday Non-Farm Payrolls automatically, also in the past, so the Before / After statistics work on all your history. Daylight saving is handled. If the jobs report moved to another day in some month (holiday), add the real time in the list below.")
i_nwTz     = input.string("America/New_York", "News list times are in",  group=G0d,
     options=["America/New_York", "UTC", "GMT+7", "GMT+8", "Europe/London"],
     tooltip="Time zone of the times you type in the list below. The default list is written in New York time (as BLS / the Fed publish it). If you copy times from a calendar in your own time zone, change this setting to match.")
i_nwList   = input.text_area("// one event per line:   YYYY-MM-DD HH:MM | name      (time in the zone chosen above)\n// lines starting with // are ignored.  NFP is automatic - do not list it.\n2026-07-14 08:30 | CPI\n2026-07-29 14:00 | FOMC\n2026-07-29 14:30 | FOMC presser\n2026-09-11 08:30 | CPI\n2026-09-16 14:00 | FOMC\n2026-09-16 14:30 | FOMC presser\n2026-10-14 08:30 | CPI\n2026-10-28 14:00 | FOMC\n2026-10-28 14:30 | FOMC presser\n2026-10-29 08:30 | GDP + PCE\n2026-11-10 08:30 | CPI\n2026-12-09 14:00 | FOMC\n2026-12-09 14:30 | FOMC presser\n2026-12-10 08:30 | CPI",
     title="High-impact news list", group=G0d,
     tooltip="Pine Script cannot read an economic calendar, so the news times are listed here. One per line: 2026-10-14 08:30 | CPI. Add the red-folder events you trade around (CPI, FOMC, GDP, PCE, Powell speeches ...). To test the past, add the past dates too. Check the dates against your own calendar before you rely on them.")
i_nwSpList = input.text_area("// speeches / testimony, one per line:   YYYY-MM-DD HH:MM | name      (same time zone as the news list)\n// example:  2026-10-20 13:00 | Fed chair speech", title="Speeches list", group=G0d,
     tooltip="Same format as the news list. These use 'Speeches: minutes BEFORE and AFTER' for the no-trade window. Lines starting with // are ignored. Add the real dates from your calendar.")
i_nwPreLen = input.int   (180,   "Stats: 'Before news' zone length (min)", group=G0d, minval=15,
     tooltip="Trades that go live in this many minutes BEFORE the no-trade window are counted as 'Before news'.")
i_nwPostLen = input.int  (120,   "Stats: 'After news' zone length (min)",  group=G0d, minval=15,
     tooltip="Trades that go live in this many minutes AFTER the 'trade again' time are counted as 'After news' (the side effect of the release).")
i_nwStat   = input.bool  (true,  "News: zone rows  (No news near / Before / Window)", group=G0e)
i_nwShade  = input.bool  (true,  "Shade the no-trade window on the chart", group=G0d)
i_nwLab    = input.bool  (true,  "Show 📰 news markers",                group=G0d)
i_rowWk    = input.bool  (true,  "Mon – Fri: 'This week' + 'Last week' rows", group=G0e)
i_rowWdSum = input.bool  (true,  "Mon – Fri: total + average win rate row",   group=G0e)
i_mwOn     = input.bool  (true,  "Month weeks: Week 1 … Week 4 rows  (Win / Loss + average)", group=G0e,
     tooltip="One row per week of the month: Week 1 = day 1–7, Week 2 = 8–14, Week 3 = 15–21, Week 4 = 22 to the end of the month. Each row shows W / L, win rate, points, and the average W / L per month. A trade counts in the week of the month it went live (time zone from 'Session times are in').")
i_mwSum    = input.bool  (true,  "Month weeks: total + average win rate row", group=G0e)
i_mwFive   = input.bool  (false, "Month weeks: show Week 5 separately  (day 29–31)", group=G0e,
     tooltip="OFF: days 29–31 are part of Week 4, so a month always has 4 weeks.\nON: days 29–31 get their own Week 5 row.")
i_nwTop    = input.bool  (true,  "News: 'After news' row at the top", group=G0e)
i_nwNext   = input.bool  (true,  "News: 'Next news' countdown row",   group=G0e)
i_rowLim   = input.bool  (true,  "Daily limit reached: show on Mon – Fri + Week 1 … 4 rows  (🎯 target · ⛔ loss limit)", group=G0e,
     tooltip="Needs 'Daily limit' ON. Each Mon … Fri and Week 1 … 4 row gets 🎯 (daily profit target reached) and ⛔ (daily loss limit reached) with the number of days. Hover the row to see which days it happened. Counted for the spread picked above (●).")
i_nthOn    = input.bool  (true,  "❖ of the day: 1st / 2nd / 3rd / 4th+ rows  (Win / Loss + avg)", group=G0e,
     tooltip="Numbers the ❖ trades of each day in the order they were placed (1st, 2nd, 3rd, 4th or later) and shows Win / Loss, win rate, pts and the average pts per trade for each. Hover a row for the dates, and for 'only the first N ❖ each day' totals (= what you would get if you stopped after the 1st / 2nd / 3rd ❖ of the day). Only ❖ that became a trade or a pending order count: ❖ skipped by the daily limit, session OFF, news, prop limits or the hedging rule get no number. A day = the chart's daily candle (same as OP). Uses the spread picked in ⓪b (●).")
i_moOn     = input.bool  (true,  "Per month row  (W / L, pts, $ for every month)", group=G0e,
     tooltip="Shows the average per month (≈ 21 trading days) and, on hover, every month: W / L, win rate, pts, R, $ at 0.01 lot, 🎯 target / ⛔ loss-limit days and trading days. A trade counts in the month it closed. Uses the spread picked in ⓪b (●).")
i_sumLog   = input.bool  (true,  "📋 Summary report in Pine Logs  (copy all results at once)", group=G0e,
     tooltip="Writes all results once into Pine Logs (indicator ⋯ menu → Pine Logs): settings, Win / Loss, Net, Avg / day, the 🧪 Breakdown, the 🔬 Filters report and every month — about 50 short lines. Copy them in one go and paste them in the chat instead of many screenshots. Written again each time the chart reloads or a setting changes.")
i_brkOn    = input.bool  (true,  "🧪 Breakdown row  (W / L by type, session, trend, flow …)", group=G0e,
     tooltip="Every closed ❖ trade of the picked spread (WIN / LOSS) grouped by: diamond type, BUY / SELL, session, 1st / 2nd / 3rd / 4th+ ❖ of the day, with / against the 1H trend, order flow with / against, ADX (weak / strong with / strong against), and location vs OP in KTR steps (cheap = BUY below OP / SELL above OP). Each line: W / L, win rate, pts and R. Values are taken when the ❖ printed.")
i_repOn    = input.bool  (true,  "🔬 Filter report row  (what the ❖ filters removed)", group=G0e,
     tooltip="Runs the v3 ❖ (same KTR rules, no ❖ filters) in the background and compares them with the filtered v4 ❖, using one SIMPLE trade test for both: entry at the ❖ close (BUY + spread), TP / SL as in ⓪b, no pending order, no daily limit, no other rules. Shows how many ❖ each filter removed and how those removed ❖ would have ended — if they are mostly LOSSES the filter helps, if mostly WINS it hurts. Numbers differ from the main Win / Loss rows because those use your full settings. Chart-candle ❖ only (not with 'confirm on lower TF').")
i_aftOn    = input.bool  (true,  "Day after ⛔ / 🎯: 1st / 2nd / 3rd ❖ rows", group=G0e,
     tooltip="Two rows: '⛔ → next day' and '🎯 → next day'. For the day right after a day that hit the ⛔ daily loss limit (or the 🎯 daily target), Win / Loss of that day's 1st, 2nd and 3rd ❖ trade, and how often the 1st and 2nd both lost ('L+L') and what the 3rd ❖ did then. Hover for pts, the comparison with all days, the W/L patterns and the dates. Needs the daily limit ON (⓪b). 'Next day' = the next daily candle (Fri → Mon). Uses the spread picked in ⓪b (●).")
i_nthLog   = input.bool  (true,  "❖ of the day: day log row  (date + result of each ❖ that day)", group=G0e,
     tooltip="Latest day with ❖ trades in the row; hover for the last 30 days, newest first: date, 1st / 2nd / 3rd … result and the day's pts. W = win · L = loss · M = missed (pending not filled) · C = closed early · open = still running.")



// ── DISPLAY + ALERTS ──
i_candleMode = input.string("KTR trend", "Candle colouring",       group=G9,
     options=["KTR trend","Order flow","Off"],
     tooltip="KTR trend = yellow/red CRAZII-style. Order flow = delta-based tint. Off = broker default candles.")
i_ofLen    = input.int   (10,    "Order flow: delta lookback bars", group=G9, minval=1)
i_colBull  = input.color (color.new(#26a69a,0), "Bullish colour", group=G9)
i_colBear  = input.color (color.new(#ef5350,0), "Bearish colour", group=G9)
i_alKtr    = input.bool  (true,  "Alert     KTR ❖ entry + WIN / LOSS", group=G10,
     tooltip="alert() message with entry / TP / SL prices when a ❖ trade opens, and WIN / LOSS when it closes.")

// ── HELPERS ──
atr14    = ta.atr(14)

// ══════════════════════════════════════════════════════════════════
// SECTION 0 — KTR MODULE  (CRAZII-style)
// Levels: OP (daily open), MLP (prev close), KTR±n = OP ± n×step%
// Candles: Supertrend yellow/red (see ⑨ Candle colouring)
// Diamonds: blue = early alert (can repeat) · ❖ = confirmed ENTRY
// ══════════════════════════════════════════════════════════════════
bool ktrNewDay = timeframe.change("D")
var float ktr_op  = na
var float ktr_mlp = na
if ktrNewDay
    ktr_mlp := close[1]
    ktr_op  := open

float ktrStep = ktr_op * i_ktrStep / 100.0
float ktrK1 = ktr_op + ktrStep
float ktrK2 = ktr_op + 2*ktrStep
float ktrK3 = ktr_op + 3*ktrStep
float ktrN1 = ktr_op - ktrStep
float ktrN2 = ktr_op - 2*ktrStep
float ktrN3 = ktr_op - 3*ktrStep

// full-width level lines — one set, moved to new prices each day
var line kOP = na, var line kMLP = na
var line kL1 = na, var line kL2 = na, var line kL3 = na
var line kB1 = na, var line kB2 = na, var line kB3 = na

f_kLine(float y, color c, string sty) =>
    line.new(bar_index, y, bar_index + 1, y, color=c, style=sty, width=1, extend=extend.both, force_overlay=true)

f_kSetY(line ln, float y) =>
    if not na(ln)
        line.set_y1(ln, y)
        line.set_y2(ln, y)

bool ktrDrawLvls = i_ktrOn and i_ktrLvls
if ktrDrawLvls and ktrNewDay and not na(ktr_op)
    if na(kOP)
        kOP := f_kLine(ktr_op, color.white, line.style_dotted)
        if i_ktrMLP
            kMLP := f_kLine(ktr_mlp, color.rgb(212,175,55), line.style_dotted)
        kL1 := f_kLine(ktrK1, color.lime,   line.style_dashed)
        kL2 := f_kLine(ktrK2, color.yellow, line.style_dashed)
        kL3 := f_kLine(ktrK3, color.orange, line.style_dashed)
        if i_ktrBelow
            kB1 := f_kLine(ktrN1, color.new(color.lime,30),   line.style_dashed)
            kB2 := f_kLine(ktrN2, color.new(color.yellow,30), line.style_dashed)
            kB3 := f_kLine(ktrN3, color.new(color.orange,30), line.style_dashed)
    else
        f_kSetY(kOP, ktr_op),  f_kSetY(kMLP, ktr_mlp)
        f_kSetY(kL1, ktrK1),   f_kSetY(kL2, ktrK2),  f_kSetY(kL3, ktrK3)
        f_kSetY(kB1, ktrN1),   f_kSetY(kB2, ktrN2),  f_kSetY(kB3, ktrN3)

// right-edge price tags
var label kTgOP = na, var label kTgML = na
var label kTg1 = na, var label kTg2 = na, var label kTg3 = na
f_kTag(float y, string txt, color c) =>
    label.new(bar_index + 3, y, txt + "  " + str.tostring(y, format.mintick),
         style=label.style_label_left, color=color.new(c,15), textcolor=color.black, size=size.small, force_overlay=true)

if barstate.islast
    label.delete(kTgOP), label.delete(kTgML)
    label.delete(kTg1), label.delete(kTg2), label.delete(kTg3)
    if ktrDrawLvls
        kTgOP := f_kTag(ktr_op, "OP", color.white)
        if i_ktrMLP and not na(ktr_mlp)
            kTgML := f_kTag(ktr_mlp, "MLP", color.rgb(212,175,55))
        kTg1 := f_kTag(ktrK1, "KTR+1", color.lime)
        kTg2 := f_kTag(ktrK2, "KTR+2", color.yellow)
        kTg3 := f_kTag(ktrK3, "KTR+3", color.orange)

// ── 30MA + Pivot 01 (CRAZII extras) ──
float kMA = ta.sma(close, i_kMALen)
plot(i_ktrOn and i_kMA ? kMA : na, "30MA", color=color.rgb(0, 230, 118), linewidth=2, force_overlay=true)

float kPivH = ta.pivothigh(high, i_kPivLen, i_kPivLen)
var float kPivLvl = na
if not na(kPivH)
    kPivLvl := kPivH
var line  kPivLn = na
var label kPivLb = na
if i_ktrOn and i_kPiv and not na(kPivLvl)
    if na(kPivLn)
        kPivLn := line.new(bar_index, kPivLvl, bar_index + 1, kPivLvl, color=color.aqua, width=1, extend=extend.both, force_overlay=true)
    else
        line.set_y1(kPivLn, kPivLvl)
        line.set_y2(kPivLn, kPivLvl)
if barstate.islast
    label.delete(kPivLb)
    if i_ktrOn and i_kPiv and not na(kPivLvl)
        kPivLb := f_kTag(kPivLvl, "Pivot 01", color.aqua)

// KTR trend (Supertrend) — also drives candle colouring
[ktrST, ktrDir] = ta.supertrend(i_ktrSTf, i_ktrSTa)
bool ktrUp = ktrDir < 0

// slow trend — bigger-picture context for continuation signals
[ktrSTs, ktrDirS] = ta.supertrend(i_ktrSTf * 2.0, i_ktrSTa)
bool ktrSlowUp = ktrDirS < 0

// stage 1 — alert diamonds (blue = buy warning, red = sell warning)
float ktrRsi = ta.rsi(close, 7)
bool ktrOS  = ta.lowest(ktrRsi, 5)  <= i_ktrRsiLo   // reversal gates
bool ktrOB  = ta.highest(ktrRsi, 5) >= i_ktrRsiHi
bool ktrOSc = ta.lowest(ktrRsi, 5)  <= 45           // softer continuation gates
bool ktrOBc = ta.highest(ktrRsi, 5) >= 55
bool ktrBullTh = close > open and close > high[1]
bool ktrBearTh = close < open and close < low[1]

// price at a fresh swing extreme — lets diamonds fire at real lows/highs
// even when a slow grind never stretches RSI to the strict zone
bool ktrAtLow  = ta.barssince(low  == ta.lowest(low, 12))  <= 3
bool ktrAtHigh = ta.barssince(high == ta.highest(high, 12)) <= 3

// REVERSAL — counter-trend exhaustion: stretched RSI OR fresh extreme
bool ktrRevBuy  = not ktrUp and ktrBullTh and (not i_ktrRsiOn or ktrOS or ktrAtLow)
bool ktrRevSell = ktrUp     and ktrBearTh and (not i_ktrRsiOn or ktrOB or ktrAtHigh)

// CONTINUATION — pullback against the SLOW trend failing (soft RSI)
// e.g. slow trend DOWN + brief yellow bounce + bearish thrust = SELL setup
bool ktrConBuy  = i_ktrCont and ktrSlowUp     and not ktrUp and ktrBullTh and (not i_ktrRsiOn or ktrOSc)
bool ktrConSell = i_ktrCont and not ktrSlowUp and ktrUp     and ktrBearTh and (not i_ktrRsiOn or ktrOBc)

// MICRO PULLBACK — small bounce too weak to flip the fast trend:
// 2+ counter-trend closes, then a thrust back with the slow trend
var int ktrUpRun = 0
var int ktrDnRun = 0
ktrUpRun := close > open ? ktrUpRun + 1 : 0
ktrDnRun := close < open ? ktrDnRun + 1 : 0
bool ktrMicSell = i_ktrCont and not ktrSlowUp and not ktrUp and ktrUpRun[1] >= 2 and ktrBearTh
bool ktrMicBuy  = i_ktrCont and ktrSlowUp     and ktrUp     and ktrDnRun[1] >= 2 and ktrBullTh

// OP side filter: price (candle close) above OP → only BUY · below OP → only SELL   (before OP exists: no filter)
bool ktrOpOn     = i_ktrOpF != "Off"
bool ktrOpDia    = i_ktrOpF == "On — diamonds and ❖"
bool ktrOpBuyOK  = not ktrOpOn or na(ktr_op) or close > ktr_op
bool ktrOpSellOK = not ktrOpOn or na(ktr_op) or close < ktr_op

var int ktrLastSig = -99999
bool ktrCoolOK = bar_index - ktrLastSig >= i_ktrCool
bool ktrShow  = i_ktrOn and i_ktrDia
bool ktrAlertBuy  = ktrShow and (ktrRevBuy  or ktrConBuy  or ktrMicBuy)  and ktrCoolOK and (not ktrOpDia or ktrOpBuyOK)
bool ktrAlertSell = ktrShow and (ktrRevSell or ktrConSell or ktrMicSell) and ktrCoolOK and (not ktrOpDia or ktrOpSellOK)
if ktrAlertBuy or ktrAlertSell
    ktrLastSig := bar_index

plotshape(ktrAlertBuy  ? low  - atr14*0.25 : na, "KTR Buy alert",  style=shape.diamond, location=location.absolute, color=color.aqua, size=size.tiny, force_overlay=true)
plotshape(ktrAlertSell ? high + atr14*0.25 : na, "KTR Sell alert", style=shape.diamond, location=location.absolute, color=color.red,  size=size.tiny, force_overlay=true)

// stage 2 — ❖ entry: trend flip OR break of the alert bar's extreme,
// whichever comes first inside the confirm window (once per alert)
var int   ktrBuyBar   = -99999
var int   ktrSellBar  = -99999
var float ktrBuyHigh  = na
var float ktrSellLow  = na
var bool  ktrBuyDone  = true
var bool  ktrSellDone = true
var int   ktrBuyType  = 0        // diamond type of the setup: 0 reversal · 1 continuation · 2 micro pullback
var int   ktrSellType = 0
if ktrAlertBuy
    ktrBuyBar  := bar_index
    ktrBuyHigh := high
    ktrBuyDone := false
    ktrBuyType := ktrRevBuy ? 0 : ktrConBuy ? 1 : 2
if ktrAlertSell
    ktrSellBar := bar_index
    ktrSellLow := low
    ktrSellDone := false
    ktrSellType := ktrRevSell ? 0 : ktrConSell ? 1 : 2
f_typeOK(int ty) =>
    ty == 0 ? i_tRev : ty == 1 ? i_tCon : i_tMic
bool kTypeBuyOK  = f_typeOK(ktrBuyType)
bool kTypeSellOK = f_typeOK(ktrSellType)

bool ktrFlipUp = ktrUp and not ktrUp[1]
bool ktrFlipDn = not ktrUp and ktrUp[1]

// Boys confirmation — the entry bar must show real participation
float ktrRelVol = volume / ta.sma(volume, 20)
bool  ktrVolOK  = not i_ktrVolC or ktrRelVol >= i_ktrVolM

// ❖ filters (options): higher-TF trend (last closed 1H / 4H candle, no repaint) and rejection wick
f_htfDir() =>
    [hSt, hDir] = ta.supertrend(i_ktrSTf, i_ktrSTa)
    hDir[1]
string kHtfTf  = i_kHtf == "4H" ? "240" : "60"
float  kHtfDir = request.security(syminfo.tickerid, kHtfTf, f_htfDir(), lookahead=barmerge.lookahead_on)
bool   kHtfBuyOK  = i_kHtf == "Off" or na(kHtfDir) or kHtfDir < 0
bool   kHtfSellOK = i_kHtf == "Off" or na(kHtfDir) or kHtfDir > 0
f_wickOK(float h, float lo, float c, int dir) =>
    float rng = h - lo
    not i_kWick or rng <= 0 or (dir == 1 ? h - c : c - lo) <= rng * i_kWickPct / 100
bool   kWickBuyOK  = f_wickOK(high, low, close, 1)
bool   kWickSellOK = f_wickOK(high, low, close, -1)
// order flow (buy − sell volume, % of volume, last i_ofLen candles) and strong one-way trend (ADX)
float  kOfBv = close >= open ? volume : volume * (close - low)  / math.max(high - low, 0.0001)
float  kOfSv = close <  open ? volume : volume * (high - close) / math.max(high - low, 0.0001)
float  kOfD  = math.sum(kOfBv - kOfSv, i_ofLen) / math.max(math.sum(kOfBv + kOfSv, i_ofLen), 0.0001) * 100
[kDiP, kDiM, kAdx] = ta.dmi(14, 14)
// chart-candle ❖ use this candle · a 5m ❖ (lower TF) uses the last closed chart candle
f_flowOK(int dir, int ago) =>
    float d = kOfD[ago]
    bool ofOK  = not i_kOfOn or na(d) or (dir == 1 ? d >= i_kOfMin : d <= -i_kOfMin)
    bool adxOK = not (i_kAdxOn and kAdx[ago] >= i_kAdxMin) or (dir == 1 ? kDiP[ago] >= kDiM[ago] : kDiM[ago] >= kDiP[ago])
    ofOK and adxOK
bool   kFlowBuyOK   = f_flowOK(1, 0)
bool   kFlowSellOK  = f_flowOK(-1, 0)
bool   kFlowBuyOK1  = f_flowOK(1, 1)
bool   kFlowSellOK1 = f_flowOK(-1, 1)

// ❖ on lower-timeframe candles (option): the diamond still comes from the chart candle, the ❖ is the
// first 1 / 3 / 5 min candle AFTER the diamond candle that confirms with the same rules
// (its trend flips, or it closes beyond the diamond candle's high / low · Boys volume · OP side)
string kLtfTf = i_ktrLtf == "1 min" ? "1" : i_ktrLtf == "3 min" ? "3" : "5"
bool   kLtfOn = i_ktrOn and i_ktrLtf != "Off (chart candles)" and timeframe.in_seconds() > timeframe.in_seconds(kLtfTf)
f_ltfKtr() =>
    [lSt, lDir] = ta.supertrend(i_ktrSTf, i_ktrSTa)
    [lDir < 0, close, high, low, volume / ta.sma(volume, 20), time_close]
[lUp, lCl, lHi, lLo, lRv, lTc] = request.security_lower_tf(syminfo.tickerid, kLtfOn ? kLtfTf : timeframe.period, f_ltfKtr(),
     ignore_invalid_timeframe=true)
var int kLtfTr   = 0            // trend of the last LTF candle: 1 up · -1 down · 0 not known yet
var int kLtfFrom = na           // first chart candle with LTF data (dashboard)
int     kLtfBuy  = -1           // which LTF candle of this chart candle confirmed the ❖ (-1 = none)
int     kLtfSell = -1
if kLtfOn and lCl.size() > 0
    if na(kLtfFrom)
        kLtfFrom := time
    bool kBuyLive  = ktrShow and not ktrBuyDone  and bar_index > ktrBuyBar  and bar_index - ktrBuyBar  <= i_ktrWin and kTypeBuyOK
    bool kSellLive = ktrShow and not ktrSellDone and bar_index > ktrSellBar and bar_index - ktrSellBar <= i_ktrWin and kTypeSellOK
    for [j, c] in lCl
        bool up  = lUp.get(j)
        bool vOK = not i_ktrVolC or lRv.get(j) >= i_ktrVolM
        if kBuyLive and kLtfBuy < 0 and vOK and (not ktrOpOn or na(ktr_op) or c > ktr_op) and kHtfBuyOK and kFlowBuyOK1 and
             f_wickOK(lHi.get(j), lLo.get(j), c, 1) and
             ((up and kLtfTr == -1) or c > ktrBuyHigh)
            kLtfBuy := j
        if kSellLive and kLtfSell < 0 and vOK and (not ktrOpOn or na(ktr_op) or c < ktr_op) and kHtfSellOK and kFlowSellOK1 and
             f_wickOK(lHi.get(j), lLo.get(j), c, -1) and
             ((not up and kLtfTr == 1) or c < ktrSellLow)
            kLtfSell := j
        kLtfTr := up ? 1 : -1

bool ktrSigBuy  = kLtfOn ? kLtfBuy >= 0 :
     ktrShow and not ktrBuyDone  and bar_index - ktrBuyBar  <= i_ktrWin and ktrVolOK and ktrOpBuyOK and kHtfBuyOK and kWickBuyOK and kFlowBuyOK and kTypeBuyOK and
     (ktrFlipUp or (bar_index > ktrBuyBar  and close > ktrBuyHigh))
bool ktrSigSell = kLtfOn ? kLtfSell >= 0 :
     ktrShow and not ktrSellDone and bar_index - ktrSellBar <= i_ktrWin and ktrVolOK and ktrOpSellOK and kHtfSellOK and kWickSellOK and kFlowSellOK and kTypeSellOK and
     (ktrFlipDn or (bar_index > ktrSellBar and close < ktrSellLow))
if ktrSigBuy
    ktrBuyDone := true
if ktrSigSell
    ktrSellDone := true
// wait 1 candle (option): the ❖ counts on the next candle if it closes beyond the middle of the ❖ candle
bool kHoldOn      = i_kHold and not kLtfOn
bool ktrEntryBuy  = kHoldOn ? ktrSigBuy[1]  and close > (high[1] + low[1]) / 2 : ktrSigBuy
bool ktrEntrySell = kHoldOn ? ktrSigSell[1] and close < (high[1] + low[1]) / 2 : ktrSigSell

// 🔬 filter report: the v3 ❖ (no filters) run in the background + one simple trade test for all
var bool kU_BuyDone  = true
var bool kU_SellDone = true
if ktrAlertBuy
    kU_BuyDone  := false
if ktrAlertSell
    kU_SellDone := false
bool kU_Buy  = not kLtfOn and ktrShow and not kU_BuyDone  and bar_index - ktrBuyBar  <= i_ktrWin and ktrVolOK and ktrOpBuyOK and
     (ktrFlipUp or (bar_index > ktrBuyBar  and close > ktrBuyHigh))
bool kU_Sell = not kLtfOn and ktrShow and not kU_SellDone and bar_index - ktrSellBar <= i_ktrWin and ktrVolOK and ktrOpSellOK and
     (ktrFlipDn or (bar_index > ktrSellBar and close < ktrSellLow))
if kU_Buy
    kU_BuyDone  := true
if kU_Sell
    kU_SellDone := true
// which filter said no: 1 higher-TF trend · 2 wick · 4 order flow / ADX · 8 wait 1 candle
f_fltMask(int dir) =>
    int mk = 0
    mk += (dir == 1 ? not kHtfBuyOK  : not kHtfSellOK)  ? 1 : 0
    mk += (dir == 1 ? not kWickBuyOK : not kWickSellOK) ? 2 : 0
    mk += (dir == 1 ? not kFlowBuyOK : not kFlowSellOK) ? 4 : 0
    mk
f_bit(int mk, int k) =>
    math.floor(mk / math.pow(2, k)) % 2 == 1
var array<int>   kShDir = array.new_int()
var array<float> kShEn  = array.new_float()
var array<int>   kShSet = array.new_int()     // 0 v3 ❖ · 1 v4 ❖ · 2 removed by the filters
var array<int>   kShMk  = array.new_int()     // filter mask (set 2)
var array<int>   kShBar = array.new_int()     // first candle to check
var array<int>   kRepW  = array.new_int(3, 0)
var array<int>   kRepL  = array.new_int(3, 0)
var array<float> kRepP  = array.new_float(3, 0.0)
var array<int>   kRepFW = array.new_int(4, 0)   // per filter (htf, wick, flow / ADX, wait 1 candle): removed ❖ that would have won
var array<int>   kRepFL = array.new_int(4, 0)   // … would have lost
var array<int>   kRepFN = array.new_int(4, 0)   // … removed in total
float kShSpr = i_kSpr
f_shAdd(int dir, float base, int set, int mk, int fromBar) =>
    kShDir.push(dir)
    kShEn.push(dir == 1 ? base + kShSpr : base)
    kShSet.push(set)
    kShMk.push(mk)
    kShBar.push(fromBar)
    if set == 2
        for k = 0 to 3
            if f_bit(mk, k)
                kRepFN.set(k, kRepFN.get(k) + 1)
    dir
bool kRepOn = i_repOn and not kLtfOn and i_ktrOn and i_kTrOn
if kRepOn and barstate.isconfirmed
    if kU_Buy
        f_shAdd(1, close, 0, 0, bar_index + 1)
        if not ktrSigBuy
            f_shAdd(1, close, 2, f_fltMask(1), bar_index + 1)
    if kU_Sell
        f_shAdd(-1, close, 0, 0, bar_index + 1)
        if not ktrSigSell
            f_shAdd(-1, close, 2, f_fltMask(-1), bar_index + 1)
    if ktrEntryBuy
        f_shAdd(1, close, 1, 0, bar_index + 1)
    if ktrEntrySell
        f_shAdd(-1, close, 1, 0, bar_index + 1)
    // removed by 'wait 1 candle': the ❖ candle closed, the next one did not hold → test it from the ❖ close
    if kHoldOn and ktrSigBuy[1] and not ktrEntryBuy
        f_shAdd(1, close[1], 2, 8, bar_index)
    if kHoldOn and ktrSigSell[1] and not ktrEntrySell
        f_shAdd(-1, close[1], 2, 8, bar_index)
    if kShDir.size() > 0
        for i = kShDir.size() - 1 to 0
            if bar_index >= kShBar.get(i)
                int   d   = kShDir.get(i)
                float en  = kShEn.get(i)
                float tpD = i_kTpPts * i_kPtVal
                float slD = i_kSlPts * i_kPtVal
                float xHi = d == 1 ? high : high + kShSpr
                float xLo = d == 1 ? low  : low  + kShSpr
                bool  hTp = d == 1 ? xHi >= en + tpD : xLo <= en - tpD
                bool  hSl = d == 1 ? xLo <= en - slD : xHi >= en + slD
                if hTp or hSl
                    bool win = hTp and (not hSl or i_kBoth == "Win")
                    int  st  = kShSet.get(i)
                    kRepW.set(st, kRepW.get(st) + (win ? 1 : 0))
                    kRepL.set(st, kRepL.get(st) + (win ? 0 : 1))
                    kRepP.set(st, kRepP.get(st) + (win ? i_kTpPts : -i_kSlPts))
                    if st == 2
                        int mk = kShMk.get(i)
                        for k = 0 to 3
                            if f_bit(mk, k)
                                kRepFW.set(k, kRepFW.get(k) + (win ? 1 : 0))
                                kRepFL.set(k, kRepFL.get(k) + (win ? 0 : 1))
                    kShDir.remove(i)
                    kShEn.remove(i)
                    kShSet.remove(i)
                    kShMk.remove(i)
                    kShBar.remove(i)

// ❖ price / time = the confirming LTF candle's close (chart candle's close when Off),
// and the high / low of the chart candle's part after it — the trades check that part first on the next candle
int   kLtfIx = not kLtfOn ? -1 : ktrEntryBuy and not ktrEntrySell ? kLtfBuy : ktrEntrySell and not ktrEntryBuy ? kLtfSell : -1
float kSigPx = kLtfIx >= 0 ? lCl.get(kLtfIx) : close
int   kSigTc = kLtfIx >= 0 ? lTc.get(kLtfIx) : time_close
float kPreHi = na
float kPreLo = na
if kLtfIx >= 0 and kLtfIx < lCl.size() - 1
    kPreHi := lHi.slice(kLtfIx + 1, lHi.size()).max()
    kPreLo := lLo.slice(kLtfIx + 1, lLo.size()).min()

color KPEACH = color.rgb(255,200,120)
plotchar(ktrEntryBuy  ? low  - atr14*0.6 : na, "KTR BUY entry ❖",  char="❖", location=location.absolute, color=KPEACH, size=size.tiny, force_overlay=true)
plotchar(ktrEntrySell ? high + atr14*0.6 : na, "KTR SELL entry ❖", char="❖", location=location.absolute, color=KPEACH, size=size.tiny, force_overlay=true)

alertcondition(ktrAlertBuy,  "KTR ① Buy alert",   "KTR blue diamond: possible buy setup")
alertcondition(ktrAlertSell, "KTR ① Sell alert",  "KTR diamond: possible sell setup")
alertcondition(ktrEntryBuy,  "KTR ② BUY ENTRY ❖", "KTR ❖ confirmed — BUY entry")
alertcondition(ktrEntrySell, "KTR ② SELL ENTRY ❖","KTR ❖ confirmed — SELL entry")

// ══════════════════════════════════════════════════════════════════
// SECTION 0d — NEWS FILTER  (high-impact)
// Zones around one news time N (minutes):
//   Before   N−(Bef+BeforeLen) … N−Bef      → trades are still allowed
//   Window   N−Bef … N+Aft                   → NO new ❖ trade (filter ON)
//   After    N+Aft … N+Aft+AfterLen          → trading again, "side effect" zone
// Several news close together simply extend the window.
// ══════════════════════════════════════════════════════════════════
var array<int>    nwTm  = array.new_int()
var array<string> nwNm  = array.new_string()
var array<string> kNwKey = array.from("📰 No news near", "📰 Before news", "📰 News window", "📰 After news")
var array<int>    kNwW   = array.new_int(4, 0)
var array<int>    kNwL   = array.new_int(4, 0)
var array<int>    kNwWB  = array.new_int(4, 0)
var array<int>    kNwLB  = array.new_int(4, 0)
var array<float>  kNwPts = array.new_float(4, 0.0)

var array<int>    nwTy  = array.new_int()          // 0 = news · 1 = speech

// read one list (news or speeches) — kind 0 = news · 1 = speech
f_nwParse(string txt, int kind) =>
    array<string> rows = str.split(txt, "\n")
    for ln in rows
        string s = str.trim(ln)
        if str.length(s) >= 16 and not str.startswith(s, "//") and not str.startswith(s, "#") and nwTm.size() < 300
            float py = str.tonumber(str.substring(s, 0, 4))
            float pm = str.tonumber(str.substring(s, 5, 7))
            float pd = str.tonumber(str.substring(s, 8, 10))
            float ph = str.tonumber(str.substring(s, 11, 13))
            float pn = str.tonumber(str.substring(s, 14, 16))
            if not na(py) and not na(pm) and not na(pd) and not na(ph) and not na(pn)
                nwTm.push(timestamp(i_nwTz, int(py), int(pm), int(pd), int(ph), int(pn), 0))
                string lab = str.length(s) > 16 ? str.trim(str.substring(s, 16)) : ""
                if str.startswith(lab, "|")
                    lab := str.trim(str.substring(lab, 1))
                nwNm.push(kind == 1 ? "🎤 " + (lab == "" ? "Speech" : lab) : (lab == "" ? "News" : lab))
                nwTy.push(kind)
    rows.size()

// read the lists once
if barstate.isfirst
    f_nwParse(i_nwList, 0)
    f_nwParse(i_nwSpList, 1)

int nwPre   = i_nwBef     * 60000
int nwPost  = i_nwAft     * 60000
int nwBefZ  = i_nwPreLen  * 60000
int nwAftZ  = i_nwPostLen * 60000
// window length before / after one event: news use the news minutes, speeches their own (0 = same as news)
f_nwPreOf(int k) =>
    k == 1 and i_nwSpMin > 0 ? i_nwSpMin * 60000 : nwPre
f_nwPostOf(int k) =>
    k == 1 and i_nwSpMin > 0 ? i_nwSpMin * 60000 : nwPost

// NFP of the New York calendar day that contains t (first Friday, 08:30 New York) — na if none
f_nfpEv(int t) =>
    int ev = na
    if i_nwNFP
        string tz = "America/New_York"
        if dayofweek(t, tz) == dayofweek.friday and dayofmonth(t, tz) <= 7
            ev := timestamp(tz, year(t, tz), month(t, tz), dayofmonth(t, tz), 8, 30, 0)
    ev

// zone of ONE news time for the candle [t0, t1):  0 normal · 1 before · 2 window · 3 after
f_nwEv(int ev, int t0, int t1, int pre, int post) =>
    int tl = t1 - 1
    int ns = ev - pre
    int ne = ev + post
    int z  = 0
    if ns < t1 and ne > t0
        z := 2
    else if tl >= ne and tl < ne + nwAftZ
        z := 3
    else if tl >= ns - nwBefZ and tl < ns
        z := 1
    z

f_nwRank(int z) =>
    z == 2 ? 3 : z == 3 ? 2 : z == 1 ? 1 : 0
f_nwUnrank(int r) =>
    r == 3 ? 2 : r == 2 ? 3 : r == 1 ? 1 : 0

// zone for the candle [t0, t1) over ALL news (window beats after, after beats before)
f_nwZone(int t0, int t1) =>
    int best = 0
    if nwTm.size() > 0
        for i = 0 to nwTm.size() - 1
            best := math.max(best, f_nwRank(f_nwEv(nwTm.get(i), t0, t1, f_nwPreOf(nwTy.get(i)), f_nwPostOf(nwTy.get(i)))))
    int e1 = f_nfpEv(t0)
    if not na(e1)
        best := math.max(best, f_nwRank(f_nwEv(e1, t0, t1, nwPre, nwPost)))
    int e2 = f_nfpEv(t1 - 1)
    if not na(e2) and (na(e1) or e2 != e1)
        best := math.max(best, f_nwRank(f_nwEv(e2, t0, t1, nwPre, nwPost)))
    f_nwUnrank(best)

// names of the news released inside this candle
f_nwHere() =>
    string s = ""
    if nwTm.size() > 0
        for i = 0 to nwTm.size() - 1
            int ev = nwTm.get(i)
            if ev >= time and ev < time_close
                s := s + (s == "" ? "" : " + ") + nwNm.get(i)
    int e = f_nfpEv(time)
    if not na(e) and e >= time and e < time_close
        s := s + (s == "" ? "" : " + ") + "NFP"
    s

// next news / speech that is not over yet (listed + auto NFP) — also returns its window minutes
f_nwNext(int tnow) =>
    int    bestEv   = na
    string bestNm   = ""
    int    bestPre  = nwPre
    int    bestPost = nwPost
    if nwTm.size() > 0
        for i = 0 to nwTm.size() - 1
            int ev = nwTm.get(i)
            int po = f_nwPostOf(nwTy.get(i))
            if ev + po > tnow and (na(bestEv) or ev < bestEv)
                bestEv   := ev
                bestNm   := nwNm.get(i)
                bestPre  := f_nwPreOf(nwTy.get(i))
                bestPost := po
    if i_nwNFP
        for dd = 0 to 35
            int c = f_nfpEv(tnow + dd * 86400000)
            if not na(c) and c + nwPost > tnow and (na(bestEv) or c < bestEv)
                bestEv   := c
                bestNm   := "NFP"
                bestPre  := nwPre
                bestPost := nwPost
    [bestEv, bestNm, bestPre, bestPost]

int  nwBar   = f_nwZone(time, time_close)          // zone of this candle
bool kNwBlk  = i_nwOn and nwBar == 2               // filter ON and this candle touches the no-trade window
bool nwStart = nwBar == 2 and nz(nwBar[1]) != 2
bool nwEnd   = nwBar != 2 and nz(nwBar[1]) == 2
// option 2 / 3 of "Just before the window starts": close the live trades at the open of the first window candle
bool kNwClose = i_nwOn and not str.startswith(i_nwAct, "Cancel") and nwStart

bgcolor(i_nwShade and nwBar == 2 ? (i_nwOn ? color.new(color.red, 88) : color.new(color.orange, 90)) : na,
     title="News no-trade window", force_overlay=true)

if i_nwLab
    string nwTxt = f_nwHere()
    if nwTxt != ""
        line.new(bar_index, low, bar_index, high, color=color.new(color.orange, 20), style=line.style_dotted, width=1,
             extend=extend.both, force_overlay=true)
        label.new(bar_index, high, (str.startswith(nwTxt, "🎤") ? "" : "📰 ") + nwTxt, style=label.style_label_down,
             color=color.new(color.orange, 15), textcolor=color.black, size=size.small,
             tooltip=nwTxt + "\nNo new ❖ trade inside the news window (see ⓪d)" +
             (i_nwOn ? "" : "\n(news filter is OFF — trades are not blocked)"),
             force_overlay=true)

alertcondition(nwStart, "📰 News no-trade window starts", "High-impact news: no-trade window started")
alertcondition(nwEnd,   "📰 News trade-again time",       "High-impact news: window over, trading allowed again")

// ══════════════════════════════════════════════════════════════════
// SECTION 0b — KTR ❖ TRADES  (Win / Loss)
// Entry "At ❖ close": the trade starts at the ❖ candle's close.
// Entry "Pending":    an order waits at ❖ close ± offset
//   LIMIT → BUY below / SELL above  ·  STOP → BUY above / SELL below
//   It only becomes a WIN / LOSS signal once price reaches it; if not
//   reached within N candles, or price runs 100 / 200 pts away from it
//   first, it is 'missed' and not counted.
// Daily limit (optional): once the day's closed trades reach the
//   target or the loss limit, no new ❖ trades until the next day.
// TP / SL are measured from the entry:
//   BUY  → TP = entry + TP pts · SL = entry − SL pts
//   SELL → TP = entry − TP pts · SL = entry + SL pts
// Spread: chart prices are BID, ASK = bid + spread.
//   BUY opens on the ask and closes (TP / SL) on the bid,
//   SELL opens on the bid and closes on the ask — so the spread
//   decides which trades win or lose, not just the points.
//   Every ❖ runs once per spread 0 / 0.18 / 0.22 / 0.30 so the
//   dashboard can compare them; only the spread picked in ⓪b is drawn.
// Whichever level is touched first decides WIN or LOSS. Only closed
// candles count. KTR ❖ only — no SMC input.
// ══════════════════════════════════════════════════════════════════
type KtrTrade
    int    dir
    float  entry
    float  tp
    float  sl
    int    bar                 // candle the trade went live
    int    tm
    box    bxTp
    box    bxSl
    bool   filled = true
    bool   lim    = false      // pending LIMIT (false = STOP)
    int    sigBar = na         // the ❖ candle
    line   lnPend = na
    label  lbPend = na
    string name   = ""         // BUY / SELL / BUY LIMIT / SELL STOP …
    int    sc     = 0          // spread scenario (index in kSt)
    int    acct   = 0          // prop account it belongs to (KtrStats.acctId)
    int    ses    = 3          // session it went live in: 0 Asia · 1 London · 2 New York · 3 other
    int    wd     = -1         // weekday it went live: 0 Mon … 4 Fri · -1 Sat / Sun
    int    nws    = 0          // news zone it went live in: 0 normal · 1 before · 2 window · 3 after
    int    wk     = 0          // week counter (for "this week so far")
    int    mw     = 0          // week of the month it went live: 0 = day 1–7 … 3 = day 22+ · 4 = day 29+ (if split)
    float  preHi  = na         // ❖ on a lower TF: high / low of the ❖ candle's part after the ❖ (checked first on the next candle)
    float  preLo  = na
    int    nth    = 0          // 1st, 2nd, 3rd … ❖ trade of its day (picked spread only)
    int    tid    = -1         // index in the ❖-of-the-day log (picked spread only)
    int    sesId  = -1         // session (kSesId) the ❖ printed in
    bool   be     = false      // break-even: SL already moved
    float  tpPts  = 200.0      // TP of this trade in pts (London can have its own)

// results for one spread
type KtrStats
    float  spr
    int    wins     = 0
    int    losses   = 0
    int    winB     = 0
    int    lossB    = 0
    int    winS     = 0
    int    lossS    = 0
    int    missed   = 0
    int    skipDay  = 0        // ❖ skipped + pending cancelled by the daily limit
    int    nOpen    = 0        // open + pending trades
    float  net      = 0.0
    float  dayPts   = 0.0
    int    dayW     = 0
    int    dayL     = 0
    bool   dayStop  = false
    string dayWhy   = ""
    int    daysTgt  = 0
    int    daysLoss = 0
    string lastTxt  = "—"
    color  lastCol  = na
    // prop firm account (⓪c)
    float  bal      = na
    float  dayBal   = na       // balance at the start of the day
    int    phase    = 1        // 1, 2, 3 = funded
    int    phDays   = 0        // trading days in this phase
    int    lastDay  = -1
    int    acctId   = 0        // new id for every new phase / account
    int    p1Pass   = 0
    int    funded   = 0
    int    fails    = 0        // failed in Phase 1 / 2
    int    fundFail = 0        // funded accounts lost
    int    blocked  = 0        // ❖ skipped by the prop limits
    int    stopped  = 0        // accounts stopped: not enough max-loss room left for one more trade
    int    hedgeSkip = 0       // ❖ skipped / pending cancelled by the hedging rule
    int    sesSkip   = 0       // ❖ skipped / pending cancelled because the session is OFF
    int    early     = 0       // trades closed early by an opposite ❖
    float  earlyPts  = 0.0
    float  fundPnl  = 0.0      // closed P&L while funded
    int    nwSkip   = 0        // ❖ skipped / pending cancelled by the news filter
    int    beN      = 0        // trades that ended at break-even
    float  bePts    = 0.0
    int    lRun     = 0        // SL in a row (for 'Skip ❖ after SL in a row')
    int    skLeft   = 0        // ❖ still to skip
    int    skN      = 0        // ❖ skipped by it
    int    sesTrId  = -1       // session (kSesId) that already has its ❖ trade ('1 ❖ trade per session')
    int    sesSlId  = -1       // session (kSesId) that had an SL ('After an SL wait for the next session')
    int    sesLimSk = 0        // ❖ skipped / pending cancelled by the per-session rule

var array<KtrTrade> kOpen = array.new<KtrTrade>()
var array<KtrStats> kSt   = array.from(KtrStats.new(0.0), KtrStats.new(0.18), KtrStats.new(0.22), KtrStats.new(0.30))
// the spread picked in ⓪b = the one drawn on the chart and shown in the main rows
int    kSel     = math.abs(i_kSpr - 0.18) < 0.001 ? 1 : math.abs(i_kSpr - 0.22) < 0.001 ? 2 : math.abs(i_kSpr - 0.30) < 0.001 ? 3 : 0

float  kTpDist  = i_kTpPts  * i_kPtVal
float  kSlDist  = i_kSlPts  * i_kPtVal
float  kOffDist = i_kOffPts * i_kPtVal
string kTpTxt   = str.tostring(i_kTpPts,  "#.##")
string kSlTxt   = str.tostring(i_kSlPts,  "#.##")
string kOffTxt  = str.tostring(i_kOffPts, "#.##")
bool   kPendOn  = i_kEntry != "At ❖ close"
bool   kLimOn   = str.startswith(i_kEntry, "Pending LIMIT")
string kRunTxt  = i_kRun == "100 pts away" ? "100" : i_kRun == "200 pts away" ? "200" : ""
float  kRunDist = kRunTxt == "" ? na : str.tonumber(kRunTxt) * i_kPtVal
color  KWIN     = color.new(#00C853,0)
color  KLOSS    = color.new(#D50000,0)
bool   kTrack   = i_ktrOn and i_kTrOn
bool   kHitWin  = false
bool   kHitLoss = false
bool   kFilled  = false

// prop firm (⓪c): $ per TP / SL point for the lot size, and the $ risk of one trade
float  kUsdPt   = i_kPtVal * i_pfOz * i_pfLot
float  kComm    = i_pfComm * i_pfLot
float  kRisk1   = i_kSlPts * kUsdPt + kComm
var array<string> kPfLog = array.new<string>()      // pass / fail history of the picked spread
// hedging rule (prop mode only): BUY and SELL open at the same time
bool   kNoHedge = i_pfOn and not str.startswith(i_pfHedge, "Allow")
bool   kRevOn   = i_pfOn and str.startswith(i_pfHedge, "Close")
var int kDayId  = 0
array<float> kPfRisk = array.new_float(4, 0.0)       // $ at risk in open + pending trades, per spread
if barstate.isfirst
    for st in kSt
        st.bal    := i_pfAcc
        st.dayBal := i_pfAcc

// session of this candle (per-session Win / Loss): New York wins over London, London over Asia
bool   kInAsia  = not na(time(timeframe.period, i_sesAsia, i_sesTz))
bool   kInLon   = not na(time(timeframe.period, i_sesLon,  i_sesTz))
bool   kInNy    = not na(time(timeframe.period, i_sesNy,   i_sesTz))
int    kSesNow  = kInNy ? 2 : kInLon ? 1 : kInAsia ? 0 : 3
var array<string> kSesNm  = array.from("Asia", "London", "New York", "Other")
var array<int>    kSesW   = array.new_int(4, 0)
var array<int>    kSesL   = array.new_int(4, 0)
var array<int>    kSesWB  = array.new_int(4, 0)     // BUY wins
var array<int>    kSesLB  = array.new_int(4, 0)     // BUY losses
var array<float>  kSesPts = array.new_float(4, 0.0)
var array<int>    kSesSkip = array.new_int(4, 0)    // ❖ skipped because the session is OFF (picked spread)
var array<int>    kSesLimSk = array.new_int(4, 0)   // ❖ skipped / cancelled by the per-session rule (picked spread)
// per-session rule: one id per session (Asia / London / New York / Other), a new day also starts a new one
bool   kSes1   = i_kSesLim == "1 ❖ trade per session"
bool   kSesSlW = i_kSesLim == "After an SL wait for the next session"
var int kSesId = 0
if kSesNow != nz(kSesNow[1], kSesNow) or ktrNewDay
    kSesId += 1
f_sesOk(int i) =>
    i == 0 ? i_sesAOn : i == 1 ? i_sesLOn : i == 2 ? i_sesNOn : i_sesOOn
bool   kSesOkNow = f_sesOk(kSesNow)


// ❖ of the day (⓪i): the 1st / 2nd / 3rd / 4th+ ❖ trade of each day (picked spread) + a log per trade
var int           kNthDay = 0                        // ❖ trades placed so far today
var int           kPrevDay = 0                       // how the previous day ended: 0 normal · 1 ⛔ loss limit · 2 🎯 target
var array<int>    kTrPrev  = array.new_int()         // per trade: kPrevDay of its day
// 🧪 breakdown: per trade (same index as kTrCode) the group of each feature at the ❖
var array<int>    kTrTyp = array.new_int()          // 0 reversal · 1 continuation · 2 micro
var array<int>    kTrDir = array.new_int()          // 1 BUY · -1 SELL
var array<int>    kTrSes = array.new_int()          // session at the ❖
var array<int>    kTrHtf = array.new_int()          // 1 with the 1H trend · -1 against · 0 unknown
var array<int>    kTrOf  = array.new_int()          // 1 order flow with the ❖ · -1 against
var array<int>    kTrAdx = array.new_int()          // 0 weak · 1 strong with · 2 strong against
var array<int>    kTrLoc = array.new_int()          // vs OP in KTR steps (cheap side −): 0 < −1 · 1 −1…0 · 2 0…+1 · 3 > +1 · -1 unknown
var array<int>    kNthW   = array.new_int(4, 0)      // [1st, 2nd, 3rd, 4th+]
var array<int>    kNthL   = array.new_int(4, 0)
var array<int>    kNthM   = array.new_int(4, 0)      // missed: pending order cancelled before it filled
var array<int>    kNthE   = array.new_int(4, 0)      // closed early
var array<float>  kNthPts = array.new_float(4, 0.0)
var array<int>    kTrDay  = array.new_int()          // per trade: its trading day (00:00 UTC of that day)
var array<int>    kTrNth  = array.new_int()          // per trade: 1st, 2nd … of that day
var array<int>    kTrCode = array.new_int()          // per trade: 1 WIN · -1 LOSS · 0 missed · 2 closed early · 9 open
var array<float>  kTrPts  = array.new_float()
f_nthRec(KtrTrade t, int code, float pts) =>
    if t.tid >= 0
        int sl = math.min(t.nth, 4) - 1
        if code == 1
            kNthW.set(sl, kNthW.get(sl) + 1)
        else if code == -1
            kNthL.set(sl, kNthL.get(sl) + 1)
        else if code == 0
            kNthM.set(sl, kNthM.get(sl) + 1)
        else
            kNthE.set(sl, kNthE.get(sl) + 1)
        kNthPts.set(sl, kNthPts.get(sl) + pts)
        kTrCode.set(t.tid, code)
        kTrPts.set(t.tid, pts)
    t
f_nthTxt(int nth) =>
    nth == 1 ? "1st" : nth == 2 ? "2nd" : nth == 3 ? "3rd" : str.tostring(nth) + "th"

float kUsdLot1 = i_kPtVal * i_pfOz                   // $ per pt for 1.00 lot

// Mon – Fri (ⓞe): weekday of the candle in the "Session times" time zone · Sat / Sun = -1
f_wd(int t) =>
    int dw = dayofweek(t, i_sesTz)
    dw >= 2 and dw <= 6 ? dw - 2 : -1
int    kWdNow  = f_wd(time)
var array<string> kWdNm  = array.from("Mon", "Tue", "Wed", "Thu", "Fri")
var array<int>    kWdW   = array.new_int(5, 0)
var array<int>    kWdL   = array.new_int(5, 0)
var array<int>    kWdWB  = array.new_int(5, 0)
var array<int>    kWdLB  = array.new_int(5, 0)
var array<float>  kWdPts = array.new_float(5, 0.0)
var array<int>    kWdCnt = array.new_int(5, 0)      // how many Mondays / Tuesdays … in the test period
var int           kWdOut = 0                         // trades that went live on Sat / Sun
// this week so far (resets when the weekday goes back, e.g. Fri → Mon)
var array<int>    kWkW   = array.new_int(5, 0)
var array<int>    kWkL   = array.new_int(5, 0)
var array<float>  kWkPts = array.new_float(5, 0.0)
var array<int>    kLwW   = array.new_int(5, 0)      // last week (the week before 'this week')
var array<int>    kLwL   = array.new_int(5, 0)
var array<float>  kLwPts = array.new_float(5, 0.0)
var int           kWkId  = 0
var int           kLastWd = -1

// Month weeks (ⓞf): 0 = day 1–7 · 1 = 8–14 · 2 = 15–21 · 3 = 22–end (or 22–28) · 4 = 29–end (only if split)
f_mw(int t) =>
    int b = math.min(math.floor((dayofmonth(t, i_sesTz) - 1) / 7), 4)
    i_mwFive ? b : math.min(b, 3)
int    kMwNow = f_mw(time)
int    kMwN   = i_mwFive ? 5 : 4
var array<int>    kMwW   = array.new_int(5, 0)
var array<int>    kMwL   = array.new_int(5, 0)
var array<int>    kMwWB  = array.new_int(5, 0)
var array<int>    kMwLB  = array.new_int(5, 0)
var array<float>  kMwPts = array.new_float(5, 0.0)
var array<int>    kMwCnt = array.new_int(5, 0)      // how many "Week 1" / "Week 2" … of the test period
// daily limit reached (🎯 target / ⛔ loss limit) per month-week and per weekday, + the latest days
var array<int>    kMwTgt  = array.new_int(5, 0)
var array<int>    kMwLoss = array.new_int(5, 0)
var array<string> kMwHit  = array.new_string(5, "")
var array<int>    kWdTgt  = array.new_int(5, 0)
var array<int>    kWdLoss = array.new_int(5, 0)
var array<string> kWdHit  = array.new_string(5, "")

// test period (a "day" = the chart's daily candle, same as the KTR OP)
var int kDaysAll = 0            // daily candles since the first ❖ trade
var int kFirstTm = na           // first ❖ trade / order
var int kChartTm = time         // first candle loaded on the chart

if ktrNewDay
    kPrevDay := kSt.get(kSel).dayWhy == "⛔ loss limit" ? 1 : kSt.get(kSel).dayWhy == "🎯 target hit" ? 2 : 0
    kDayId += 1
    kNthDay := 0
    for st in kSt
        st.dayBal  := st.bal
        st.dayPts  := 0.0
        st.dayW    := 0
        st.dayL    := 0
        st.dayStop := false
        if i_kSkDay
            st.lRun   := 0
            st.skLeft := 0
        st.dayWhy  := ""
    if not na(kFirstTm)
        kDaysAll += 1

if kWdNow >= 0
    if kWdNow < kLastWd
        kWkId += 1
        for i = 0 to 4
            kLwW.set(i, kWkW.get(i))
            kLwL.set(i, kWkL.get(i))
            kLwPts.set(i, kWkPts.get(i))
        kWkW.fill(0)
        kWkL.fill(0)
        kWkPts.fill(0.0)
    kLastWd := kWdNow
// count each Mon / Tue / … of the test period (for the per-weekday average)
bool kWdChg = dayofweek(time, i_sesTz) != dayofweek(time[1], i_sesTz)
if kWdChg and kWdNow >= 0 and not na(kFirstTm)
    kWdCnt.set(kWdNow, kWdCnt.get(kWdNow) + 1)
if kMwNow != nz(kMwNow[1], -1) and not na(kFirstTm)
    kMwCnt.set(kMwNow, kMwCnt.get(kMwNow) + 1)

f_kZone(float a, float b, color c, string txt) =>
    box.new(bar_index, math.max(a, b), bar_index + 1, math.min(a, b),
         border_color=color.new(c,60), bgcolor=color.new(c,85), border_width=1,
         text=txt, text_color=c, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center,
         force_overlay=true)

// TP / SL zones start on the candle the trade goes live
f_kZones(KtrTrade t) =>
    if i_kZones
        t.bxTp := f_kZone(t.entry, t.tp, KWIN,  "TP +" + str.tostring(t.tpPts, "#") + " pts  " + str.tostring(t.tp, format.mintick))
        t.bxSl := f_kZone(t.entry, t.sl, KLOSS, "SL −" + kSlTxt + " pts  " + str.tostring(t.sl, format.mintick))
    t

// prop: the first live trade of a day counts as a trading day for the phase
f_pfDay(KtrStats st) =>
    if st.lastDay != kDayId
        st.phDays  += 1
        st.lastDay := kDayId
    st

// prop: fresh account for the next phase (or a new Phase 1 after a fail)
f_pfNew(KtrStats st, int ph) =>
    st.bal     := i_pfAcc
    st.dayBal  := i_pfAcc
    st.phase   := ph
    st.phDays  := 0
    st.lastDay := -1
    st.acctId  += 1
    st

// prop: would one more trade still fit inside the daily and max loss (minus buffer)?
f_pfRoom(KtrStats st, float openRisk) =>
    float buf    = i_pfBuf / 100 * i_pfAcc
    float dayAmt = i_pfDay / 100 * math.min(st.dayBal, i_pfAcc)
    float maxAmt = i_pfMax / 100 * i_pfAcc
    float need   = openRisk + kRisk1
    (i_pfDay == 0 or (st.dayBal - st.bal) + need <= dayAmt - buf) and (i_pfAcc - st.bal) + need <= maxAmt - buf

// is a trade in the other direction live in this account?
f_kOpp(int sc, int dir, int acct) =>
    bool found = false
    for t in kOpen
        if t.sc == sc and t.filled and t.dir == -dir and t.acct == acct
            found := true
    found

// keep the latest daily-limit days of one bucket as text lines (oldest dropped)
f_hitAppend(array<string> arr, int idx, string txt) =>
    string s = arr.get(idx) + txt + "\n"
    while str.length(s) > 900
        int cut = int(str.pos(s, "\n"))
        s := str.substring(s, cut + 1)
    arr.set(idx, s)

// month number (year × 12 + month − 1) in the "Session times" time zone
f_moIx(int t) =>
    year(t, i_sesTz) * 12 + month(t, i_sesTz) - 1

// 📆 per month (picked spread): a trade counts in the month it closed · days = daily candles since the first ❖ trade
var array<int>    kMoKey = array.new_int()          // month number (f_moIx)
var array<int>    kMoW   = array.new_int()
var array<int>    kMoL   = array.new_int()
var array<int>    kMoE   = array.new_int()          // closed early
var array<float>  kMoPts = array.new_float()
var array<int>    kMoDay = array.new_int()          // trading days
var array<int>    kMoTg  = array.new_int()          // 🎯 target days
var array<int>    kMoLs  = array.new_int()          // ⛔ loss-limit days
f_moSlot() =>
    int k = f_moIx(time)
    if kMoKey.size() == 0 or kMoKey.last() != k
        kMoKey.push(k)
        kMoW.push(0)
        kMoL.push(0)
        kMoE.push(0)
        kMoPts.push(0.0)
        kMoDay.push(0)
        kMoTg.push(0)
        kMoLs.push(0)
    kMoKey.size() - 1
f_moRec(KtrTrade t, int code, float pts) =>
    int i = f_moSlot()
    if code == 1
        kMoW.set(i, kMoW.get(i) + 1)
    else if code == -1
        kMoL.set(i, kMoL.get(i) + 1)
    else
        kMoE.set(i, kMoE.get(i) + 1)
    kMoPts.set(i, kMoPts.get(i) + pts)
    i
f_moDay() =>
    int i = f_moSlot()
    kMoDay.set(i, kMoDay.get(i) + 1)
    i
if ktrNewDay and not na(kFirstTm)
    f_moDay()

// remember on which week of the month / weekday the daily limit was reached
f_hitRec(float pts, int w, int l, bool tgt) =>
    string hitTxt = (tgt ? "🎯 " : "⛔ ") + str.format_time(time, "EEE dd MMM yy", i_sesTz) + " · " + str.tostring(pts, "+0;-0") +
         " pts (" + str.tostring(w) + "W " + str.tostring(l) + "L)"
    if tgt
        kMwTgt.set(kMwNow, kMwTgt.get(kMwNow) + 1)
    else
        kMwLoss.set(kMwNow, kMwLoss.get(kMwNow) + 1)
    f_hitAppend(kMwHit, kMwNow, hitTxt)
    if kWdNow >= 0
        if tgt
            kWdTgt.set(kWdNow, kWdTgt.get(kWdNow) + 1)
        else
            kWdLoss.set(kWdNow, kWdLoss.get(kWdNow) + 1)
        f_hitAppend(kWdHit, kWdNow, hitTxt)

// daily limit (points) reached with this result → stop for the day
f_kDayCheck(KtrStats st, bool isMain) =>
    if i_kDayOn and not st.dayStop and (st.dayPts >= i_kDayTp or st.dayPts <= -i_kDaySl)
        bool kTgt = st.dayPts >= i_kDayTp
        st.dayStop  := true
        st.daysTgt  += kTgt ? 1 : 0
        st.daysLoss += kTgt ? 0 : 1
        st.dayWhy   := kTgt ? "🎯 target hit" : "⛔ loss limit"
        if isMain
            f_hitRec(st.dayPts, st.dayW, st.dayL, kTgt)
            int mi = f_moSlot()
            if kTgt
                kMoTg.set(mi, kMoTg.get(mi) + 1)
            else
                kMoLs.set(mi, kMoLs.get(mi) + 1)
        if isMain and i_kDayLab
            label.new(bar_index, kTgt ? high + atr14 * 1.5 : low - atr14 * 1.5,
                 (kTgt ? "🎯 DAY TARGET " : "⛔ DAY STOP ") + str.tostring(st.dayPts, "+#.##;-#.##") + " pts",
                 style=kTgt ? label.style_label_down : label.style_label_up,
                 color=color.new(kTgt ? KWIN : KLOSS, 30), textcolor=color.white, size=size.small,
                 tooltip="Daily limit: target +" + str.tostring(i_kDayTp, "#.##") + " / loss −" + str.tostring(i_kDaySl, "#.##") +
                 " pts\nToday " + str.tostring(st.dayW) + "W " + str.tostring(st.dayL) + "L → no new ❖ trades until the next daily candle",
                 force_overlay=true)
        if isMain and i_alKtr
            alert("KTR ❖ DAILY " + (kTgt ? "TARGET HIT" : "LOSS LIMIT HIT") + " — " + syminfo.ticker +
                 " | Today " + str.tostring(st.dayPts, "+#.##;-#.##") + " pts (" + str.tostring(st.dayW) + "W " + str.tostring(st.dayL) + "L)" +
                 " | No new ❖ trades until tomorrow",
                 alert.freq_once_per_bar_close)
    st

// close a live trade at this candle's close (opposite ❖ with 'Close open trade') — not a WIN / LOSS
f_kCloseNow(KtrTrade t, KtrStats st, float base, string why) =>
    float px  = t.dir == 1 ? base : base + st.spr        // BUY exits on the bid, SELL on the ask
    float pts = t.dir * (px - t.entry) / i_kPtVal
    st.early    += 1
    st.earlyPts += pts
    if t.sc == kSel
        f_nthRec(t, 2, pts)
        f_moRec(t, 2, pts)
        kSesPts.set(t.ses, kSesPts.get(t.ses) + pts)
        if t.wd >= 0
            kWdPts.set(t.wd, kWdPts.get(t.wd) + pts)
            if t.wk == kWkId
                kWkPts.set(t.wd, kWkPts.get(t.wd) + pts)
            else if t.wk == kWkId - 1
                kLwPts.set(t.wd, kLwPts.get(t.wd) + pts)
        kNwPts.set(t.nws, kNwPts.get(t.nws) + pts)
        kMwPts.set(t.mw, kMwPts.get(t.mw) + pts)
    st.net      += pts
    st.dayPts   += pts
    st.nOpen    -= 1
    if i_pfOn and t.acct == st.acctId
        float usd = pts * kUsdPt - kComm
        st.bal     += usd
        st.fundPnl += st.phase == 3 ? usd : 0.0
    st.lastTxt := "CLOSED " + str.tostring(pts, "+#;-#") + " · " + t.name
    st.lastCol := color.gray
    if t.sc == kSel
        if not na(t.bxTp)
            box.set_right(t.bxTp, bar_index)
        if not na(t.bxSl)
            box.set_right(t.bxSl, bar_index)
        if i_kWLlab
            label.new(bar_index, px, "CLOSED " + str.tostring(pts, "+#;-#"), style=label.style_label_left,
                 color=color.new(color.gray, 20), textcolor=color.white, size=size.small,
                 tooltip="KTR ❖ " + t.name + " from " + str.format_time(t.tm, "dd MMM HH:mm") + " closed early by " + why +
                 "\nEntry " + str.tostring(t.entry, format.mintick) + " · exit " + str.tostring(px, format.mintick) + " → " + str.tostring(pts, "+#.#;-#.#") + " pts",
                 force_overlay=true)
        if i_alKtr
            alert("KTR ❖ " + t.name + " CLOSED by " + why + " — " + syminfo.ticker +
                 " | Entry:" + str.tostring(t.entry, format.mintick) + " | Exit:" + str.tostring(px, format.mintick) +
                 " | " + str.tostring(pts, "+#.#;-#.#") + " pts",
                 alert.freq_once_per_bar_close)
    t

// pending order cancelled before it filled (not a win, not a loss) — drawn for the picked spread only
f_kCancel(KtrTrade t, string why) =>
    KtrStats cs = kSt.get(t.sc)
    if cs.sesTrId == t.sesId
        cs.sesTrId := -1             // never filled → the session can still take a ❖ ('1 ❖ trade per session')
    if t.sc == kSel
        f_nthRec(t, 0, 0)
        if not na(t.lnPend)
            line.set_x2(t.lnPend, bar_index)
            line.set_color(t.lnPend, color.gray)
        if not na(t.lbPend)
            label.set_text(t.lbPend, t.name + " ✕ " + why)
            label.set_color(t.lbPend, color.new(color.gray, 20))
        if i_alKtr
            alert("KTR ❖ " + t.name + " CANCELLED — " + why + " — " + syminfo.ticker +
                 " | " + str.tostring(t.entry, format.mintick) + " not filled, not counted",
                 alert.freq_once_per_bar_close)
    t

// 1) settle pending orders and open trades first, so a new ❖ on the same candle can still open
if kTrack and kOpen.size() > 0
    for i = kOpen.size() - 1 to 0
        KtrTrade kt = kOpen.get(i)
        KtrStats st = kSt.get(kt.sc)
        bool  kMain    = kt.sc == kSel
        bool  kDone    = false
        bool  kFillNow = false
        // chart = bid · BUY opens on the ask, closes on the bid · SELL the other way round
        float kS  = st.spr
        float eHi = kt.dir == 1 ? high + kS : high
        float eLo = kt.dir == 1 ? low  + kS : low
        float xHi = kt.dir == 1 ? high  : high  + kS
        float xLo = kt.dir == 1 ? low   : low   + kS
        float xCl = kt.dir == 1 ? close : close + kS
        // news protection (option 2 / 3): close live trades at the open of the first window candle
        if kNwClose and kt.filled and barstate.isconfirmed
            f_kCloseNow(kt, st, open, "the news window")
            if i_pfOn
                kPfRisk.set(kt.sc, math.max(kPfRisk.get(kt.sc) - kRisk1, 0.0))
            f_kDayCheck(st, kMain)
            kOpen.remove(i)
            continue
        // ❖ on a lower TF: the rest of the ❖ candle (after the ❖) came before this candle → check it first
        bool  kPre     = not na(kt.preHi) and bar_index == kt.sigBar + 1
        bool  kFillPre = false
        float pEHi = kt.dir == 1 ? kt.preHi + kS : kt.preHi
        float pELo = kt.dir == 1 ? kt.preLo + kS : kt.preLo
        float pXHi = kt.dir == 1 ? kt.preHi : kt.preHi + kS
        float pXLo = kt.dir == 1 ? kt.preLo : kt.preLo + kS
        float pXCl = kt.dir == 1 ? close[1] : close[1] + kS
        // BUY LIMIT / SELL STOP are reached from above (price falling into them)
        bool kFillDn = (kt.dir == 1) == kt.lim
        if not kt.filled and barstate.isconfirmed and bar_index > kt.sigBar
            // ran away = moved X pts off the order on the side it was waiting on
            bool kTouchP  = kPre and (kFillDn ? pELo <= kt.entry : pEHi >= kt.entry)
            bool kRanP    = kPre and not na(kRunDist) and (kFillDn ? pEHi >= kt.entry + kRunDist : pELo <= kt.entry - kRunDist)
            bool kTouch   = kTouchP or (not kRanP and (kFillDn ? eLo <= kt.entry : eHi >= kt.entry))
            bool kRanAway = kRanP or (not na(kRunDist) and (kFillDn ? eHi >= kt.entry + kRunDist : eLo <= kt.entry - kRunDist))
            if kNwBlk
                kDone      := true
                st.nwSkip  += 1
                st.nOpen   -= 1
                f_kCancel(kt, "news window")
                kOpen.remove(i)
            else if kTouch and not kSesOkNow
                kDone      := true
                st.sesSkip += 1
                st.nOpen   -= 1
                if kMain
                    kSesSkip.set(kSesNow, kSesSkip.get(kSesNow) + 1)
                f_kCancel(kt, kSesNm.get(kSesNow) + " session OFF")
                kOpen.remove(i)
            else if kTouch and kNoHedge and f_kOpp(kt.sc, kt.dir, kt.acct)
                kDone        := true
                st.hedgeSkip += 1
                st.nOpen     -= 1
                f_kCancel(kt, "no hedge (opposite trade open)")
                kOpen.remove(i)
            else if kTouch
                kt.filled := true
                kFillPre  := kTouchP
                kt.ses    := kSesNow
                kt.wd     := kWdNow
                kt.nws    := nwBar
                kt.wk     := kWkId
                kt.mw     := kMwNow
                kt.bar    := bar_index
                kt.tm     := time
                kFillNow  := true
                if i_pfOn and kt.acct == st.acctId
                    f_pfDay(st)
                if kMain
                    kFilled := true
                    f_kZones(kt)
                    if not na(kt.lnPend)
                        line.set_x2(kt.lnPend, bar_index)
                    if not na(kt.lbPend)
                        label.set_text(kt.lbPend, kt.name + " ✓ filled")
                    if i_alKtr
                        alert("KTR ❖ " + kt.name + " FILLED — " + syminfo.ticker +
                             " | Entry:" + str.tostring(kt.entry, format.mintick) +
                             " | TP:" + str.tostring(kt.tp, format.mintick) + " (+" + kTpTxt + " pts)" +
                             " | SL:" + str.tostring(kt.sl, format.mintick) + " (−" + kSlTxt + " pts)",
                             alert.freq_once_per_bar_close)
            else if kRanAway or bar_index - kt.sigBar >= i_kExp
                kDone     := true
                st.missed += 1
                st.nOpen  -= 1
                f_kCancel(kt, kRanAway ? "missed (ran " + kRunTxt + " pts)" : "missed (" + str.tostring(i_kExp) + " candles)")
                kOpen.remove(i)
        if kt.filled and not kDone and barstate.isconfirmed and (bar_index > kt.bar or kFillNow)
            // on the fill candle only count what surely came after the fill:
            // filled on the way down → its low came later, its high maybe not (close is sure)
            // ❖ on a lower TF: the rest of the ❖ candle comes first — if it already hit TP / SL, judge on it alone
            float pHi  = kFillPre and kFillDn     ? pXCl : pXHi
            float pLo  = kFillPre and not kFillDn ? pXCl : pXLo
            bool  pHit = kPre and (not kFillNow or kFillPre) and
                 (kt.dir == 1 ? pHi >= kt.tp or pLo <= kt.sl : pLo <= kt.tp or pHi >= kt.sl)
            bool  kFC  = kFillNow and not kFillPre
            float aHi  = pHit ? pHi : kFC and kFillDn     ? xCl : xHi
            float aLo  = pHit ? pLo : kFC and not kFillDn ? xCl : xLo
            bool hitTP = kt.dir == 1 ? aHi >= kt.tp : aLo <= kt.tp
            bool hitSL = kt.dir == 1 ? aLo <= kt.sl : aHi >= kt.sl
            // break-even: the moved SL is hit (TP on the same candle only wins with 'TP and SL … = Win')
            if kt.be and hitSL and not (hitTP and i_kBoth == "Win")
                st.beN  += 1
                st.bePts += kt.dir * (kt.sl - kt.entry) / i_kPtVal
                f_kCloseNow(kt, st, kt.dir == 1 ? kt.sl : kt.sl - kS, "break-even")
                if i_pfOn
                    kPfRisk.set(kt.sc, math.max(kPfRisk.get(kt.sc) - kRisk1, 0.0))
                f_kDayCheck(st, kMain)
                kOpen.remove(i)
                kDone := true
                hitTP := false
                hitSL := false
            if hitTP or hitSL
                bool  kWin  = hitTP and (not hitSL or i_kBoth == "Win")
                float kGain = kWin ? kt.tpPts : -i_kSlPts
                kDone     := true
                st.wins   += kWin ? 1 : 0
                st.losses += kWin ? 0 : 1
                // SL in a row → skip the next ❖ (option)
                st.lRun := kWin ? 0 : st.lRun + 1
                if not kWin
                    st.sesSlId := kSesId
                if i_kSkOn and st.lRun >= i_kSkN
                    st.skLeft := i_kSkM
                    st.lRun   := 0
                st.winB   += kWin and kt.dir == 1 ? 1 : 0
                st.lossB  += not kWin and kt.dir == 1 ? 1 : 0
                st.winS   += kWin and kt.dir == -1 ? 1 : 0
                st.lossS  += not kWin and kt.dir == -1 ? 1 : 0
                st.net    += kGain
                st.dayPts += kGain
                st.dayW   += kWin ? 1 : 0
                st.dayL   += kWin ? 0 : 1
                st.nOpen  -= 1
                if i_pfOn and kt.acct == st.acctId
                    float kUsd = kWin ? kt.tpPts * kUsdPt - kComm : -kRisk1
                    st.bal     += kUsd
                    st.fundPnl += st.phase == 3 ? kUsd : 0.0
                string kRes = kWin ? "WIN +" + str.tostring(kt.tpPts, "#") : "LOSS −" + kSlTxt
                st.lastTxt := kRes + " · " + kt.name
                st.lastCol := kWin ? KWIN : KLOSS
                if kMain
                    f_nthRec(kt, kWin ? 1 : -1, kGain)
                    f_moRec(kt, kWin ? 1 : -1, kGain)
                    kHitWin  := kHitWin or kWin
                    kHitLoss := kHitLoss or not kWin
                    kSesW.set(kt.ses,   kSesW.get(kt.ses)   + (kWin ? 1 : 0))
                    kSesL.set(kt.ses,   kSesL.get(kt.ses)   + (kWin ? 0 : 1))
                    kSesWB.set(kt.ses,  kSesWB.get(kt.ses)  + (kWin and kt.dir == 1 ? 1 : 0))
                    kSesLB.set(kt.ses,  kSesLB.get(kt.ses)  + (not kWin and kt.dir == 1 ? 1 : 0))
                    kSesPts.set(kt.ses, kSesPts.get(kt.ses) + kGain)
                    if kt.wd >= 0
                        kWdW.set(kt.wd,  kWdW.get(kt.wd)  + (kWin ? 1 : 0))
                        kWdL.set(kt.wd,  kWdL.get(kt.wd)  + (kWin ? 0 : 1))
                        kWdWB.set(kt.wd, kWdWB.get(kt.wd) + (kWin and kt.dir == 1 ? 1 : 0))
                        kWdLB.set(kt.wd, kWdLB.get(kt.wd) + (not kWin and kt.dir == 1 ? 1 : 0))
                        kWdPts.set(kt.wd, kWdPts.get(kt.wd) + kGain)
                        if kt.wk == kWkId
                            kWkW.set(kt.wd, kWkW.get(kt.wd) + (kWin ? 1 : 0))
                            kWkL.set(kt.wd, kWkL.get(kt.wd) + (kWin ? 0 : 1))
                            kWkPts.set(kt.wd, kWkPts.get(kt.wd) + kGain)
                        else if kt.wk == kWkId - 1
                            kLwW.set(kt.wd, kLwW.get(kt.wd) + (kWin ? 1 : 0))
                            kLwL.set(kt.wd, kLwL.get(kt.wd) + (kWin ? 0 : 1))
                            kLwPts.set(kt.wd, kLwPts.get(kt.wd) + kGain)
                    else
                        kWdOut += 1
                    kNwW.set(kt.nws,  kNwW.get(kt.nws)  + (kWin ? 1 : 0))
                    kNwL.set(kt.nws,  kNwL.get(kt.nws)  + (kWin ? 0 : 1))
                    kNwWB.set(kt.nws, kNwWB.get(kt.nws) + (kWin and kt.dir == 1 ? 1 : 0))
                    kNwLB.set(kt.nws, kNwLB.get(kt.nws) + (not kWin and kt.dir == 1 ? 1 : 0))
                    kNwPts.set(kt.nws, kNwPts.get(kt.nws) + kGain)
                    kMwW.set(kt.mw,  kMwW.get(kt.mw)  + (kWin ? 1 : 0))
                    kMwL.set(kt.mw,  kMwL.get(kt.mw)  + (kWin ? 0 : 1))
                    kMwWB.set(kt.mw, kMwWB.get(kt.mw) + (kWin and kt.dir == 1 ? 1 : 0))
                    kMwLB.set(kt.mw, kMwLB.get(kt.mw) + (not kWin and kt.dir == 1 ? 1 : 0))
                    kMwPts.set(kt.mw, kMwPts.get(kt.mw) + kGain)
                    if not na(kt.bxTp)
                        box.set_right(kt.bxTp, bar_index)
                    if not na(kt.bxSl)
                        box.set_right(kt.bxSl, bar_index)
                    if i_kWLlab
                        bool kAbove = (kt.dir == 1) == kWin
                        label.new(bar_index, kWin ? kt.tp : kt.sl, kRes,
                             style=kAbove ? label.style_label_down : label.style_label_up,
                             color=kWin ? KWIN : KLOSS, textcolor=color.white, size=size.small,
                             tooltip="KTR ❖ " + kt.name + " from " + str.format_time(kt.tm, "dd MMM HH:mm") +
                             "\nEntry " + str.tostring(kt.entry, format.mintick) +
                             " · TP " + str.tostring(kt.tp, format.mintick) +
                             " · SL " + str.tostring(kt.sl, format.mintick) +
                             "\n" + kRes + " pts after " + str.tostring(bar_index - kt.bar) + " candles · " + kSesNm.get(kt.ses) + " session" +
                             (kt.nth > 0 ? " · " + f_nthTxt(kt.nth) + " ❖ of the day" : ""),
                             force_overlay=true)
                    if i_alKtr
                        alert("KTR ❖ " + kt.name + " " + (kWin ? "WIN — TP hit" : "LOSS — SL hit") + " — " + syminfo.ticker +
                             " | Entry:" + str.tostring(kt.entry, format.mintick) +
                             " | Exit:" + str.tostring(kWin ? kt.tp : kt.sl, format.mintick) +
                             " | " + (kWin ? "+" + kTpTxt : "−" + kSlTxt) + " pts" +
                             " | Total " + str.tostring(st.wins) + "W " + str.tostring(st.losses) + "L",
                             alert.freq_once_per_bar_close)
                // this trade reached the daily target / loss limit → stop for the day
                f_kDayCheck(st, kMain)
                kOpen.remove(i)
            // break-even: +X pts reached at this candle → SL to entry (+ lock) from the next candle on
            if i_kBeOn and not kDone and not kt.be
                float kFav = kt.dir == 1 ? aHi - kt.entry : kt.entry - aLo
                if kFav >= i_kBePts * i_kPtVal
                    kt.be := true
                    kt.sl := kt.entry + kt.dir * i_kBeLock * i_kPtVal
        if not kDone and kMain
            if not na(kt.bxTp)
                box.set_right(kt.bxTp, bar_index + 1)
            if not na(kt.bxSl)
                box.set_right(kt.bxSl, bar_index + 1)
            if not kt.filled and not na(kt.lnPend)
                line.set_x2(kt.lnPend, bar_index + 1)

// 3) prop firm account per spread: equity at the candle's worst price → fail, else target → pass
if kTrack and i_pfOn and barstate.isconfirmed
    array<float> kFlt = array.new_float(kSt.size(), 0.0)
    for kt in kOpen
        KtrStats st = kSt.get(kt.sc)
        if kt.acct == st.acctId
            kPfRisk.set(kt.sc, kPfRisk.get(kt.sc) + kRisk1)
            if kt.filled
                float w = kt.dir == 1 ? low - kt.entry : kt.entry - (high + st.spr)
                kFlt.set(kt.sc, kFlt.get(kt.sc) + math.max(math.min(w, 0.0), -kSlDist) / i_kPtVal * kUsdPt)
    for sc = 0 to kSt.size() - 1
        KtrStats st = kSt.get(sc)
        float eqLo   = st.bal + kFlt.get(sc)
        float dayAmt = i_pfDay / 100 * math.min(st.dayBal, i_pfAcc)
        float tgtPct = st.phase == 1 ? i_pfT1 : i_pfT2
        bool  bDay   = i_pfDay > 0 and st.dayBal - eqLo >= dayAmt
        bool  bMax   = i_pfAcc - eqLo >= i_pfMax / 100 * i_pfAcc
        bool  bPass  = not (bDay or bMax) and st.phase < 3 and st.bal >= i_pfAcc * (1 + tgtPct / 100) and st.phDays >= i_pfMinD
        // with Block on, an account whose max-loss room is smaller than one trade can never trade again → stop it
        bool  bStuck = not (bDay or bMax or bPass) and i_pfGuard and kPfRisk.get(sc) == 0 and st.bal < i_pfAcc and
             (i_pfAcc - st.bal) + kRisk1 > (i_pfMax - i_pfBuf) / 100 * i_pfAcc
        if bDay or bMax or bPass or bStuck
            string kPh  = st.phase == 3 ? "FUNDED ACCOUNT" : "PHASE " + str.tostring(st.phase)
            string kEv  = bPass ? (st.phase == 1 and i_pfT2 > 0 ? "✅ PHASE 1 PASSED" : "🏆 FUNDED") :
                 bStuck ? "⛔ " + kPh + " STOPPED — 1 more loss would break max loss" :
                 (st.phase == 3 ? "❌ FUNDED ACCOUNT LOST" : "❌ " + kPh + " FAILED") + (bDay ? " — daily loss" : " — max loss")
            string kEvB = "$" + str.tostring(bPass or bStuck ? st.bal : eqLo, "#,##0") + " after " + str.tostring(st.phDays) + " trading days"
            if bPass
                st.p1Pass += st.phase == 1 ? 1 : 0
                st.funded += st.phase == 2 or i_pfT2 == 0 ? 1 : 0
            else if bStuck
                st.stopped += 1
            else
                st.fails    += st.phase < 3 ? 1 : 0
                st.fundFail += st.phase == 3 ? 1 : 0
            if sc == kSel and i_pfLab
                label.new(bar_index, bPass ? high + atr14 * 2.5 : low - atr14 * 2.5, kEv + "\n" + kEvB,
                     style=bPass ? label.style_label_down : label.style_label_up,
                     color=bPass ? color.new(#FFD600, 10) : color.new(KLOSS, 10), textcolor=bPass ? color.black : color.white,
                     size=size.normal, force_overlay=true)
            if sc == kSel
                kPfLog.push(str.format_time(time, "dd MMM yy") + ": " + kEv + " · " + kEvB)
                if kPfLog.size() > 10
                    kPfLog.shift()
                if i_alKtr
                    alert("KTR ❖ PROP " + kEv + " — " + syminfo.ticker + " | " + kEvB, alert.freq_once_per_bar_close)
            f_pfNew(st, bPass ? (st.phase == 1 and i_pfT2 > 0 ? 2 : 3) : 1)
            kPfRisk.set(sc, 0.0)

// daily limit reached → cancel orders that are still pending (per spread)
if kTrack and i_kDayOn and barstate.isconfirmed and kOpen.size() > 0
    for i = kOpen.size() - 1 to 0
        KtrTrade kt = kOpen.get(i)
        KtrStats st = kSt.get(kt.sc)
        if st.dayStop and not kt.filled
            st.skipDay += 1
            st.nOpen   -= 1
            f_kCancel(kt, "day limit")
            kOpen.remove(i)

// per-session rule 'After an SL wait for the next session' → cancel orders placed in this session that are still pending
if kTrack and kSesSlW and barstate.isconfirmed and kOpen.size() > 0
    for i = kOpen.size() - 1 to 0
        KtrTrade kt = kOpen.get(i)
        KtrStats st = kSt.get(kt.sc)
        if st.sesSlId == kSesId and kt.sesId == kSesId and not kt.filled
            st.sesLimSk += 1
            st.nOpen    -= 1
            if kt.sc == kSel
                kSesLimSk.set(kSesNow, kSesLimSk.get(kSesNow) + 1)
            f_kCancel(kt, "SL this session")
            kOpen.remove(i)

// 🧪 breakdown: remember the ❖'s groups (picked spread, same index as kTrCode)
f_brkPush(int dir) =>
    int   ty  = dir == 1 ? ktrBuyType : ktrSellType
    float stp = ktrStep
    float x   = na(ktr_op) or na(stp) or stp == 0 ? na : (kSigPx - ktr_op) / stp * dir
    kTrTyp.push(ty)
    kTrDir.push(dir)
    kTrSes.push(kSesNow)
    kTrHtf.push(na(kHtfDir) ? 0 : (kHtfDir < 0) == (dir == 1) ? 1 : -1)
    kTrOf.push(kOfD * dir >= 0 ? 1 : -1)
    kTrAdx.push(kAdx < i_kAdxMin ? 0 : (kDiP >= kDiM) == (dir == 1) ? 1 : 2)
    kTrLoc.push(na(x) ? -1 : x < -1 ? 0 : x < 0 ? 1 : x < 1 ? 2 : 3)
    dir

// 2) a confirmed ❖ opens a trade, or places the pending order — once per spread
int kDir = ktrEntryBuy and not ktrEntrySell ? 1 : ktrEntrySell and not ktrEntryBuy ? -1 : 0
if kTrack and barstate.isconfirmed and kDir != 0
    string kNm = (kDir == 1 ? "BUY" : "SELL") + (kPendOn ? (kLimOn ? " LIMIT" : " STOP") : "")
    // the order is placed at the ❖ candle's close → is that moment inside a news no-trade window?
    int    kNwPlaceZ   = f_nwZone(kSigTc, kSigTc + 1)
    bool   kNwPlaceBlk = i_nwOn and kNwPlaceZ == 2
    for sc = 0 to kSt.size() - 1
        if sc == kSel or i_kSprCmp
            KtrStats st = kSt.get(sc)
            // per-session rule: this session already had its ❖ trade / an SL → skip (checked before the hedging close)
            bool kSesLimBlk = (kSes1 and st.sesTrId == kSesId) or (kSesSlW and st.sesSlId == kSesId)
            // hedging rule: close the opposite trades first (and cancel opposite pending orders)
            if kRevOn and kSesOkNow and not kNwPlaceBlk and not kSesLimBlk and kOpen.size() > 0
                for i = kOpen.size() - 1 to 0
                    KtrTrade t = kOpen.get(i)
                    if t.sc == sc and t.dir == -kDir and t.acct == st.acctId
                        if t.filled
                            f_kCloseNow(t, st, kSigPx, "the opposite ❖")
                        else
                            st.hedgeSkip += 1
                            st.nOpen     -= 1
                            f_kCancel(t, "reversed")
                        if i_pfOn
                            kPfRisk.set(sc, math.max(kPfRisk.get(sc) - kRisk1, 0.0))
                        kOpen.remove(i)
                f_kDayCheck(st, sc == kSel)
            bool kOpp  = kNoHedge and not kRevOn and f_kOpp(sc, kDir, st.acctId)
            bool kFree = not i_kOne or st.nOpen == 0
            if i_kDayOn and st.dayStop
                st.skipDay += 1
            else if not kSesOkNow
                st.sesSkip += 1
                if sc == kSel
                    kSesSkip.set(kSesNow, kSesSkip.get(kSesNow) + 1)
            else if kSesLimBlk
                st.sesLimSk += 1
                if sc == kSel
                    kSesLimSk.set(kSesNow, kSesLimSk.get(kSesNow) + 1)
                    if i_kWLlab
                        label.new(bar_index, kDir == 1 ? low - atr14 * 1.2 : high + atr14 * 1.2, kSes1 ? "1 / session" : "SL → next session",
                             style=kDir == 1 ? label.style_label_up : label.style_label_down,
                             color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny,
                             tooltip="❖ " + (kDir == 1 ? "BUY" : "SELL") + " skipped (" + kSesNm.get(kSesNow) + "): " +
                             (kSes1 ? "this session already had its ❖ trade" : "a trade hit SL in this session") + " — wait for the next session",
                             force_overlay=true)
            else if kNwPlaceBlk
                st.nwSkip += 1
            else if kOpp
                st.hedgeSkip += 1
            else if kFree and i_pfOn and i_pfGuard and not f_pfRoom(st, kPfRisk.get(sc))
                st.blocked += 1
            else if kFree and i_kSkOn and st.skLeft > 0
                st.skLeft -= 1
                st.skN    += 1
                if sc == kSel
                    kTrDay.push(time_tradingday)
                    kTrNth.push(0)
                    kTrPrev.push(kPrevDay)
                    f_brkPush(kDir)
                    kTrCode.push(3)
                    kTrPts.push(0.0)
                    if i_kWLlab
                        label.new(bar_index, kDir == 1 ? low - atr14 * 1.2 : high + atr14 * 1.2, "skip",
                             style=kDir == 1 ? label.style_label_up : label.style_label_down,
                             color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny,
                             tooltip="❖ " + (kDir == 1 ? "BUY" : "SELL") + " skipped: " + str.tostring(i_kSkN) + " SL in a row before it (Skip ❖ after SL in a row)",
                             force_overlay=true)
            else if kFree
                if na(kFirstTm)
                    kFirstTm := time
                    kDaysAll := 1
                    f_moDay()
                    if kWdNow >= 0
                        kWdCnt.set(kWdNow, kWdCnt.get(kWdNow) + 1)
                    kMwCnt.set(kMwNow, kMwCnt.get(kMwNow) + 1)
                // pending: LIMIT = BUY below / SELL above the ❖ close · STOP = BUY above / SELL below
                // at ❖ close: BUY fills on the ask (close + spread), SELL on the bid
                float kEn   = kPendOn ? kSigPx + (kLimOn ? -kDir : kDir) * kOffDist : kDir == 1 ? kSigPx + st.spr : kSigPx
                float kTpP  = i_kTpLon > 0 and kSesNow == 1 ? i_kTpLon : i_kTpPts
                float kTpPx = kEn + kDir * kTpP * i_kPtVal
                float kSlPx = kEn - kDir * kSlDist
                KtrTrade kNew = KtrTrade.new(dir=kDir, entry=kEn, tp=kTpPx, sl=kSlPx, bar=bar_index, tm=time,
                     filled=not kPendOn, lim=kLimOn, sigBar=bar_index, name=kNm, sc=sc, acct=st.acctId, ses=kSesNow,
                     wd=kWdNow, nws=kNwPlaceZ, wk=kWkId, mw=kMwNow, preHi=kPreHi, preLo=kPreLo, sesId=kSesId, tpPts=kTpP)
                st.sesTrId := kSesId
                if sc == kSel
                    kNthDay  += 1
                    kNew.nth := kNthDay
                    kNew.tid := kTrCode.size()
                    kTrDay.push(time_tradingday)
                    kTrNth.push(kNthDay)
                    kTrPrev.push(kPrevDay)
                    f_brkPush(kDir)
                    kTrCode.push(9)
                    kTrPts.push(0.0)
                    string kOffS = (kEn >= kSigPx ? "+" : "−") + kOffTxt
                    if kPendOn and i_kPendLab
                        kNew.lnPend := line.new(bar_index, kEn, bar_index + 1, kEn, color=KPEACH, style=line.style_dashed, width=1, force_overlay=true)
                        kNew.lbPend := label.new(bar_index, kEn, kNm + " " + kOffS,
                             style=label.style_label_right, color=color.new(KPEACH, 20), textcolor=color.black, size=size.tiny,
                             tooltip="❖ close " + str.tostring(kSigPx, format.mintick) + " → " + kNm + " at " + str.tostring(kEn, format.mintick) +
                             "\nTP " + str.tostring(kTpPx, format.mintick) + " (+" + kTpTxt + " pts) · SL " + str.tostring(kSlPx, format.mintick) + " (−" + kSlTxt + " pts)" +
                             "\nCancelled after " + str.tostring(i_kExp) + " candles" + (kRunTxt == "" ? "" : " or if price runs " + kRunTxt + " pts away first"),
                             force_overlay=true)
                    else if not kPendOn
                        f_kZones(kNew)
                    if i_alKtr
                        alert("KTR ❖ " + kNm + (kPendOn ? " PLACED" : " ENTRY") + " — " + syminfo.ticker +
                             " | Entry:" + str.tostring(kEn, format.mintick) +
                             (kPendOn ? " (❖ close " + str.tostring(kSigPx, format.mintick) + " " + kOffS + " pts, expires in " + str.tostring(i_kExp) + " candles)" : "") +
                             " | TP:" + str.tostring(kTpPx, format.mintick) + " (+" + kTpTxt + " pts)" +
                             " | SL:" + str.tostring(kSlPx, format.mintick) + " (−" + kSlTxt + " pts)",
                             alert.freq_once_per_bar_close)
                kOpen.push(kNew)
                st.nOpen += 1
                if i_pfOn
                    kPfRisk.set(sc, kPfRisk.get(sc) + kRisk1)
                    if not kPendOn
                        f_pfDay(st)

alertcondition(kFilled,  "KTR ❖ pending filled", "KTR ❖ pending order filled — trade is live")
alertcondition(kHitWin,  "KTR ❖ TP hit — WIN",  "KTR ❖ trade closed at TP — WIN")
alertcondition(kHitLoss, "KTR ❖ SL hit — LOSS", "KTR ❖ trade closed at SL — LOSS")

// ── SECTION 6 — ORDER FLOW + CANDLE COLOUR MODE ──
float bVol  = close>=open ? volume : volume*(close-low) /math.max(high-low,0.0001)
float sVol  = close< open ? volume : volume*(high-close)/math.max(high-low,0.0001)
float dRat  = math.sum(bVol-sVol,i_ofLen) / math.max(math.sum(bVol+sVol,i_ofLen),0.0001)*100

// Candle colouring — one place, three modes (⑨ Display)
color candCol = i_candleMode == "KTR trend" ? (ktrUp ? color.yellow : color.red) :
     i_candleMode == "Order flow" ? (dRat>0 ? color.new(i_colBull,55) : color.new(i_colBear,55)) : na
barcolor(candCol, title="Candle colouring")

// ── SECTION 14 — DASHBOARD ──
// KTR row for dashboard
string kStr = not i_ktrOn ? "OFF" :
     ktrEntryBuy ? "❖ BUY entry" : ktrEntrySell ? "❖ SELL entry" :
     ktrAlertBuy ? "◆ Buy alert" : ktrAlertSell ? "◆ Sell alert" :
     ktrUp ? "▲ Bull trend" : "▼ Bear trend"
color kCol = not i_ktrOn ? color.new(#8B949E,0) :
     (ktrEntryBuy or ktrAlertBuy) ? color.new(#00C853,0) :
     (ktrEntrySell or ktrAlertSell) ? color.new(#D50000,0) :
     ktrUp ? color.yellow : color.new(#D50000,0)


var table d = table.new(position.top_right, 2, 75,
     bgcolor=color.new(#0D1117,60), border_color=color.new(#30363D,40),
     border_width=1, frame_color=color.new(#30363D,40), frame_width=1,
     force_overlay=true)
color CH=color.new(#1C2128,55)
color CR=color.new(#0D1117,60)
color CL=color.new(#8B949E,0)

// one dashboard row (key | value) — returns the next row index
f_dRow(int r, string k, string v, color bg, color vc, string sz, string tip) =>
    table.cell(d, 0, r, k, bgcolor=bg, text_color=CL, text_size=sz)
    table.cell(d, 1, r, v, bgcolor=bg, text_color=vc, text_size=sz, tooltip=tip)
    r + 1

f_wr(int w, int l) =>
    w + l > 0 ? " (" + str.tostring(w * 100.0 / (w + l), "#") + "%)" : ""

// KTR ❖ trade stats — main rows use the spread picked in ⓪b
KtrStats kM     = kSt.get(kSel)
int    kWins    = kM.wins
int    kLosses  = kM.losses
float  kNetPts  = kM.net
bool   kDayBlock = i_kDayOn and kM.dayStop
int kPendN = 0
int kLiveN = 0
if kOpen.size() > 0
    for kt in kOpen
        if kt.sc == kSel
            kPendN += kt.filled ? 0 : 1
            kLiveN += kt.filled ? 1 : 0
int    kN      = kWins + kLosses
float  kNetR   = kNetPts / i_kSlPts          // 1R = the SL size
string kWLStr  = str.tostring(kWins) + "W " + str.tostring(kLosses) + "L" + f_wr(kWins, kLosses) +
     (kLiveN    > 0 ? " · " + str.tostring(kLiveN)    + " open"    : "") +
     (kPendN    > 0 ? " · " + str.tostring(kPendN)    + " pending" : "") +
     (kM.missed > 0 ? " · " + str.tostring(kM.missed) + " missed"  : "") +
     (kM.early  > 0 ? " · " + str.tostring(kM.early)  + " closed early" : "") +
     (i_kSkOn and kM.skN > 0 ? " · " + str.tostring(kM.skN) + " skipped" : "") +
     ((kSes1 or kSesSlW) and kM.sesLimSk > 0 ? " · " + str.tostring(kM.sesLimSk) + " session-skipped" : "")
color  kWLCol  = kN == 0 ? CL : kNetPts >= 0 ? KWIN : KLOSS
string kNetStr = str.tostring(kNetPts, "+#.##;-#.##") + " pts  (" + str.tostring(kNetR, "+#.#;-#.#") + "R)"
string kWLTip  = "Spread " + str.tostring(kM.spr, "0.00") +
     "\nBUY ❖:  " + str.tostring(kM.winB) + "W " + str.tostring(kM.lossB) + "L" + f_wr(kM.winB, kM.lossB) +
     "\nSELL ❖: " + str.tostring(kM.winS) + "W " + str.tostring(kM.lossS) + "L" + f_wr(kM.winS, kM.lossS) +
     "\nOpen now: " + str.tostring(kLiveN) + " · pending: " + str.tostring(kPendN) +
     "\nMissed (pending not reached, not counted): " + str.tostring(kM.missed) +
     "\nSkipped / cancelled by the daily limit: " + str.tostring(kM.skipDay) +
     "\nSkipped / cancelled because the session is OFF: " + str.tostring(kM.sesSkip) +
     "\nSkipped / cancelled by the news filter: " + str.tostring(kM.nwSkip) +
     (i_kBeOn ? "\nEnded at break-even: " + str.tostring(kM.beN) + " (" + str.tostring(kM.bePts, "+#;-#") + " pts, in 'closed early')" : "") +
     (i_kSkOn ? "\nSkipped after " + str.tostring(i_kSkN) + " SL in a row: " + str.tostring(kM.skN) + " ❖" : "") +
     (kSes1 or kSesSlW ? "\nSkipped / cancelled by the per-session rule (" + i_kSesLim + "): " + str.tostring(kM.sesLimSk) : "") +
     (i_pfOn ? "\nHedging rule: " + i_pfHedge + " · skipped / cancelled: " + str.tostring(kM.hedgeSkip) +
     " · closed early: " + str.tostring(kM.early) + " (" + str.tostring(kM.earlyPts, "+#.#;-#.#") + " pts)" : "") +
     "\nBreak-even win rate: " + str.tostring(i_kSlPts * 100.0 / (i_kTpPts + i_kSlPts), "#") + "%"
string kNetTip = "1R = SL = " + kSlTxt + " pts → a WIN is +" + str.tostring(i_kTpPts / i_kSlPts, "#.##") + "R, a LOSS −1R" +
     "\n" + str.tostring(kWins) + " × " + kTpTxt + " − " + str.tostring(kLosses) + " × " + kSlTxt +
     (kM.early > 0 ? " " + str.tostring(kM.earlyPts, "+#.#;-#.#") + " (" + str.tostring(kM.early) + " closed early)" : "") +
     " = " + str.tostring(kNetPts, "+#.##;-#.##") + " pts" +
     "\n= " + str.tostring(kNetPts * i_kPtVal, "+#.##;-#.##") + " in price  (1 pt = " + str.tostring(i_kPtVal) + ")" +
     "\nSpread " + str.tostring(kM.spr, "0.00") + " is already inside the W / L (BUY opens on the ask, SELL closes on the ask)"

// one dashboard row per spread: W / L and Net
f_sprRow(int r, int sc) =>
    KtrStats st = kSt.get(sc)
    int    n    = st.wins + st.losses
    string k    = (sc == kSel ? "● " : "") + "Spread " + str.tostring(st.spr, "0.00")
    string v    = str.tostring(st.wins) + "W " + str.tostring(st.losses) + "L" + f_wr(st.wins, st.losses) +
         " · " + str.tostring(st.net, "+#;-#") + " pts (" + str.tostring(st.net / i_kSlPts, "+#.#;-#.#") + "R)"
    color  vc   = n == 0 ? CL : st.net >= 0 ? KWIN : KLOSS
    string tip  = "Spread " + str.tostring(st.spr, "0.00") + (st.spr > 0 ? " (e.g. bid 4285.17 / ask " + str.tostring(4285.17 + st.spr, "0.00") + ")" : "") +
         "\nBUY ❖:  " + str.tostring(st.winB) + "W " + str.tostring(st.lossB) + "L" + f_wr(st.winB, st.lossB) +
         "\nSELL ❖: " + str.tostring(st.winS) + "W " + str.tostring(st.lossS) + "L" + f_wr(st.winS, st.lossS) +
         "\nMissed: " + str.tostring(st.missed) +
         (i_kDayOn ? "\nDaily limit — target days: " + str.tostring(st.daysTgt) + " · loss-limit days: " + str.tostring(st.daysLoss) +
         " · skipped: " + str.tostring(st.skipDay) : "") +
         "\nLast: " + st.lastTxt +
         (i_pfOn ? "\nProp: Phase 1 passed " + str.tostring(st.p1Pass) + " · funded " + str.tostring(st.funded) +
         " · failed " + str.tostring(st.fails + st.fundFail) + " · stopped " + str.tostring(st.stopped) + " · blocked " + str.tostring(st.blocked) +
         "\nSession OFF skipped: " + str.tostring(st.sesSkip) +
         "\nHedging rule: skipped " + str.tostring(st.hedgeSkip) + " · closed early " + str.tostring(st.early) + " (" + str.tostring(st.earlyPts, "+#.#;-#.#") + " pts)" : "")
    f_dRow(r, k, v, CR, vc, size.tiny, tip)

// one dashboard row per session (picked spread)
f_sesHrs(string sess) =>
    str.substring(sess, 0, 2) + ":" + str.substring(sess, 2, 4) + "–" + str.substring(sess, 5, 7) + ":" + str.substring(sess, 7, 9)
f_sesRow(int r, int i, string hrs) =>
    int    w   = kSesW.get(i)
    int    l   = kSesL.get(i)
    int    wb  = kSesWB.get(i)
    int    lb  = kSesLB.get(i)
    float  pt  = kSesPts.get(i)
    string v   = str.tostring(w) + "W " + str.tostring(l) + "L" + f_wr(w, l) + " · " + str.tostring(pt, "+#;-#") +
         " pts (" + str.tostring(pt / i_kSlPts, "+#.#;-#.#") + "R)"
    bool   on  = f_sesOk(i)
    int    sk  = kSesSkip.get(i)
    if not on
        v := "OFF · " + str.tostring(sk) + " ❖ skipped" + (w + l > 0 ? " · " + str.tostring(w) + "W " + str.tostring(l) + "L" : "")
    color  vc  = not on ? color.gray : w + l == 0 ? CL : pt >= 0 ? KWIN : KLOSS
    string tip = kSesNm.get(i) + " " + hrs + (i < 3 ? " (" + i_sesTz + ")" : "") + (on ? " · ON" : " · OFF — no ❖ trades here") +
         (sk > 0 ? "\n❖ skipped / pending cancelled here: " + str.tostring(sk) : "") +
         (kSesLimSk.get(i) > 0 ? "\n❖ skipped / cancelled by the per-session rule here: " + str.tostring(kSesLimSk.get(i)) : "") +
         "\nBUY ❖:  " + str.tostring(wb) + "W " + str.tostring(lb) + "L" + f_wr(wb, lb) +
         "\nSELL ❖: " + str.tostring(w - wb) + "W " + str.tostring(l - lb) + "L" + f_wr(w - wb, l - lb) +
         "\nSpread " + str.tostring(kM.spr, "0.00") + " · counted where the trade went live"
    f_dRow(r, "🕐 " + kSesNm.get(i) + (on ? "" : " ✕"), v, CR, vc, size.tiny, tip)

// ── daily limit reached: short text for the row + hover list ──
f_limVal(int tg, int ls) =>
    i_kDayOn and i_rowLim and tg + ls > 0 ? "  │ 🎯" + str.tostring(tg) + " ⛔" + str.tostring(ls) : ""

f_limTip(int tg, int ls, string hits, string nm) =>
    string s = ""
    if i_kDayOn and i_rowLim
        s := "\n\nDaily limit (🎯 +" + str.tostring(i_kDayTp, "#.##") + " / ⛔ −" + str.tostring(i_kDaySl, "#.##") + " pts) reached in " + nm + ":"
        if tg + ls == 0
            s := s + " never"
        else
            s := s + "\n🎯 target reached: " + str.tostring(tg) + " day(s) · ⛔ loss limit reached: " + str.tostring(ls) +
                 " day(s)\nLatest days:\n" + hits
    s

// ── Mon – Fri rows ──
f_wdRow(int r, int i) =>
    int    w   = kWdW.get(i)
    int    l   = kWdL.get(i)
    int    wb  = kWdWB.get(i)
    int    lb  = kWdLB.get(i)
    float  pt  = kWdPts.get(i)
    int    cnt = kWdCnt.get(i)
    int    cw  = 0
    int    cl  = 0
    float  cp  = 0.0
    for j = 0 to i
        cw += kWdW.get(j)
        cl += kWdL.get(j)
        cp += kWdPts.get(j)
    string v   = w + l == 0 ? "no trades" :
         str.tostring(w) + "W " + str.tostring(l) + "L" + f_wr(w, l) + " · " + str.tostring(pt, "+0;-0") + " pts"
    if i > 0
        v := v + "  │ Σ " + str.tostring(cw) + "W " + str.tostring(cl) + "L" + f_wr(cw, cl) + " " + str.tostring(cp, "+0;-0")
    color  vc  = w + l == 0 ? CL : pt >= 0 ? KWIN : KLOSS
    string tip = kWdNm.get(i) + " — ❖ trades that went live on a " + kWdNm.get(i) + " (" + i_sesTz + ")" +
         "\nBUY ❖:  " + str.tostring(wb) + "W " + str.tostring(lb) + "L" + f_wr(wb, lb) +
         "\nSELL ❖: " + str.tostring(w - wb) + "W " + str.tostring(l - lb) + "L" + f_wr(w - wb, l - lb) +
         (cnt > 0 ? "\nAverage per " + kWdNm.get(i) + " (" + str.tostring(cnt) + " days): " + str.tostring(w * 1.0 / cnt, "0.0") + "W " +
         str.tostring(l * 1.0 / cnt, "0.0") + "L · " + str.tostring(pt / cnt, "+#;-#") + " pts" : "") +
         "\nΣ = running total from Monday up to " + kWdNm.get(i) + ": " + str.tostring(cw) + "W " + str.tostring(cl) + "L" + f_wr(cw, cl) +
         " · " + str.tostring(cp, "+0;-0") + " pts" +
         "\nSpread " + str.tostring(kM.spr, "0.00")
    v   := v + f_limVal(kWdTgt.get(i), kWdLoss.get(i))
    tip := tip + f_limTip(kWdTgt.get(i), kWdLoss.get(i), kWdHit.get(i), kWdNm.get(i))
    f_dRow(r, (kWdNow == i ? "▶ " : "") + "📅 " + kWdNm.get(i), v, CR, vc, size.tiny, tip)

// this week so far, running Mon → today
f_wkRow(int r) =>
    int    cw  = 0
    int    cl  = 0
    float  cp  = 0.0
    string tip = "This week so far — running total, trades counted on the day they went live\n"
    for i = 0 to 4
        cw += kWkW.get(i)
        cl += kWkL.get(i)
        cp += kWkPts.get(i)
        tip := tip + kWdNm.get(i) + ":  " + str.tostring(kWkW.get(i)) + "W " + str.tostring(kWkL.get(i)) + "L " +
             str.tostring(kWkPts.get(i), "+0;-0") + " pts   →  Σ " + str.tostring(cw) + "W " + str.tostring(cl) + "L " +
             str.tostring(cp, "+0;-0") + " pts\n"
    string v  = cw + cl == 0 ? "no closed trades yet" :
         "Σ " + str.tostring(cw) + "W " + str.tostring(cl) + "L" + f_wr(cw, cl) + " · " + str.tostring(cp, "+0;-0") + " pts"
    f_dRow(r, "📅 This week", v, CR, cw + cl == 0 ? CL : cp >= 0 ? KWIN : KLOSS, size.tiny, tip)

// last week, running Mon → Fri
f_lwRow(int r) =>
    int    cw  = 0
    int    cl  = 0
    float  cp  = 0.0
    string tip = "Last week — running total Mon → Fri, trades counted on the day they went live\n"
    for i = 0 to 4
        cw += kLwW.get(i)
        cl += kLwL.get(i)
        cp += kLwPts.get(i)
        tip := tip + kWdNm.get(i) + ":  " + str.tostring(kLwW.get(i)) + "W " + str.tostring(kLwL.get(i)) + "L " +
             str.tostring(kLwPts.get(i), "+0;-0") + " pts   →  Σ " + str.tostring(cw) + "W " + str.tostring(cl) + "L " +
             str.tostring(cp, "+0;-0") + " pts\n"
    string v  = cw + cl == 0 ? "no trades (or less than 2 weeks of data)" :
         "Σ " + str.tostring(cw) + "W " + str.tostring(cl) + "L" + f_wr(cw, cl) + " · " + str.tostring(cp, "+0;-0") + " pts"
    f_dRow(r, "📅 Last week", v, CR, cw + cl == 0 ? CL : cp >= 0 ? KWIN : KLOSS, size.tiny, tip)

// Mon – Fri total + average win rate
f_wdSum(int r) =>
    int    tw   = 0
    int    tl   = 0
    float  tp   = 0.0
    float  wrS  = 0.0
    int    wrN  = 0
    float  bWr  = -1.0
    float  wWr  = 101.0
    int    bI   = -1
    int    wI   = -1
    for i = 0 to 4
        int w = kWdW.get(i)
        int l = kWdL.get(i)
        tw += w
        tl += l
        tp += kWdPts.get(i)
        if w + l > 0
            float wr = w * 100.0 / (w + l)
            wrS += wr
            wrN += 1
            if wr > bWr
                bWr := wr
                bI  := i
            if wr < wWr
                wWr := wr
                wI  := i
    string v = tw + tl == 0 ? "—" :
         str.tostring(tw) + "W " + str.tostring(tl) + "L" + f_wr(tw, tl) + " · avg WR " + str.tostring(wrS / wrN, "#") + "%" +
         (wrN >= 2 ? " · best " + kWdNm.get(bI) + " · worst " + kWdNm.get(wI) : "")
    string tip = "Mon – Fri total: " + str.tostring(tw) + "W " + str.tostring(tl) + "L · " + str.tostring(tp, "+0;-0") + " pts" +
         "\nTotal win rate = all wins / all trades" +
         "\nAvg WR = the average of the daily win rates (each weekday counts the same)" +
         (kWdOut > 0 ? "\nTrades that went live on Sat / Sun (not in these rows): " + str.tostring(kWdOut) : "")
    f_dRow(r, "📅 Mon–Fri", v, CH, tw + tl == 0 ? CL : tp >= 0 ? KWIN : KLOSS, size.tiny, tip)

// ── month-week rows ──
f_mwRange(int k) =>
    k == 0 ? "1–7" : k == 1 ? "8–14" : k == 2 ? "15–21" : k == 3 ? (i_mwFive ? "22–28" : "22–end") : "29–end"

f_mwRow(int r, int k) =>
    int    w   = kMwW.get(k)
    int    l   = kMwL.get(k)
    int    wb  = kMwWB.get(k)
    int    lb  = kMwLB.get(k)
    float  pt  = kMwPts.get(k)
    int    cnt = kMwCnt.get(k)
    string v   = w + l == 0 ? "no trades" :
         str.tostring(w) + "W " + str.tostring(l) + "L" + f_wr(w, l) + " · " + str.tostring(pt, "+0;-0") + " pts"
    if w + l > 0 and cnt > 0
        v := v + "  │ avg " + str.tostring(w * 1.0 / cnt, "0.0") + "W " + str.tostring(l * 1.0 / cnt, "0.0") + "L"
    color  vc  = w + l == 0 ? CL : pt >= 0 ? KWIN : KLOSS
    string tip = "Week " + str.tostring(k + 1) + " of the month = day " + f_mwRange(k) + " (" + i_sesTz + ")" +
         "\nBUY ❖:  " + str.tostring(wb) + "W " + str.tostring(lb) + "L" + f_wr(wb, lb) +
         "\nSELL ❖: " + str.tostring(w - wb) + "W " + str.tostring(l - lb) + "L" + f_wr(w - wb, l - lb) +
         (cnt > 0 ? "\nAverage per month (" + str.tostring(cnt) + " months): " + str.tostring(w * 1.0 / cnt, "0.0") + "W " +
         str.tostring(l * 1.0 / cnt, "0.0") + "L · " + str.tostring(pt / cnt, "+#;-#") + " pts" : "") +
         "\nSpread " + str.tostring(kM.spr, "0.00")
    v   := v + f_limVal(kMwTgt.get(k), kMwLoss.get(k))
    tip := tip + f_limTip(kMwTgt.get(k), kMwLoss.get(k), kMwHit.get(k), "Week " + str.tostring(k + 1))
    f_dRow(r, (kMwNow == k ? "▶ " : "") + "🗓 Week " + str.tostring(k + 1) + " (" + f_mwRange(k) + ")", v, CR, vc, size.tiny, tip)

f_mwSum(int r) =>
    int    tw   = 0
    int    tl   = 0
    float  tp   = 0.0
    float  wrS  = 0.0
    int    wrN  = 0
    int    mMax = 0
    int    tgS  = 0
    int    lsS  = 0
    float  bWr  = -1.0
    float  wWr  = 101.0
    int    bI   = -1
    int    wI   = -1
    for i = 0 to kMwN - 1
        int w = kMwW.get(i)
        int l = kMwL.get(i)
        tw += w
        tl += l
        tp += kMwPts.get(i)
        mMax := math.max(mMax, kMwCnt.get(i))
        tgS += kMwTgt.get(i)
        lsS += kMwLoss.get(i)
        if w + l > 0
            float wr = w * 100.0 / (w + l)
            wrS += wr
            wrN += 1
            if wr > bWr
                bWr := wr
                bI  := i
            if wr < wWr
                wWr := wr
                wI  := i
    string v = tw + tl == 0 ? "—" :
         str.tostring(tw) + "W " + str.tostring(tl) + "L" + f_wr(tw, tl) + " · avg WR " + str.tostring(wrS / wrN, "#") + "%" +
         (wrN >= 2 ? " · best Wk" + str.tostring(bI + 1) + " · worst Wk" + str.tostring(wI + 1) : "")
    string tip = "All weeks of the month: " + str.tostring(tw) + "W " + str.tostring(tl) + "L · " + str.tostring(tp, "+0;-0") + " pts" +
         "\nAvg WR = the average of the weekly win rates (each week counts the same)" +
         (mMax > 0 ? "\nAverage per month (" + str.tostring(mMax) + " months): " + str.tostring(tw * 1.0 / mMax, "0.0") + "W " +
         str.tostring(tl * 1.0 / mMax, "0.0") + "L · " + str.tostring(tp / mMax, "+#;-#") + " pts" : "")
    v   := v + f_limVal(tgS, lsS)
    tip := tip + (i_kDayOn and i_rowLim ? "\n\nDaily limit reached in all weeks: 🎯 " + str.tostring(tgS) + " · ⛔ " + str.tostring(lsS) + " day(s)" : "")
    f_dRow(r, "🗓 Weeks avg", v, CH, tw + tl == 0 ? CL : tp >= 0 ? KWIN : KLOSS, size.tiny, tip)

// ── news rows ──
f_dur(int ms) =>
    int    m = math.round(ms / 60000.0)
    string s = str.tostring(m) + "m"
    if m >= 1440
        s := str.tostring(math.floor(m / 1440)) + "d " + str.tostring(math.floor((m % 1440) / 60)) + "h"
    else if m >= 60
        s := str.tostring(math.floor(m / 60)) + "h " + str.tostring(m % 60) + "m"
    s

f_nwStatusRow(int r) =>
    [ev, nm, nPre, nPost] = f_nwNext(timenow)
    string v   = "no news in the list"
    color  vc  = CL
    string tip = "Add your high-impact news times in ⓪d (NFP is automatic)."
    if not na(ev)
        bool inWin = timenow >= ev - nPre and timenow < ev + nPost
        string whenTxt = str.format_time(ev, "dd MMM HH:mm", i_nwTz) + " (" + i_nwTz + ")"
        if inWin
            v  := (i_nwOn ? "🚫 NO TRADE · " : "⚠ window (filter OFF) · ") + nm +
                 (ev > timenow ? " in " + f_dur(ev - timenow) : " released " + f_dur(timenow - ev) + " ago") +
                 " · trade again in " + f_dur(ev + nPost - timenow)
            vc := i_nwOn ? KLOSS : color.orange
        else
            v  := "✅ clear · " + nm + " in " + f_dur(ev - timenow)
            vc := ev - timenow < 3 * 3600000 ? color.orange : KWIN
        tip := "Next: " + nm + " — " + whenTxt +
             "\nNo trade from " + str.tostring(nPre / 60000) + " min before until " + str.tostring(nPost / 60000) + " min after" +
             "\nJust before the window: " + i_nwAct +
             "\nFilter: " + (i_nwOn ? "ON" : "OFF")
    f_dRow(r, "📰 Next news", v, CH, vc, size.tiny, tip)

f_nwRow(int r, int z) =>
    int    w   = kNwW.get(z)
    int    l   = kNwL.get(z)
    int    wb  = kNwWB.get(z)
    int    lb  = kNwLB.get(z)
    float  pt  = kNwPts.get(z)
    string v   = str.tostring(w) + "W " + str.tostring(l) + "L" + f_wr(w, l) + " · " + str.tostring(pt, "+0;-0") +
         " pts (" + str.tostring(pt / i_kSlPts, "+#.#;-#.#") + "R)"
    if z == 2 and i_nwOn
        v := "🚫 " + str.tostring(kM.nwSkip) + " ❖ skipped" + (w + l > 0 ? " · open before: " + str.tostring(w) + "W " + str.tostring(l) + "L" + f_wr(w, l) : "")
    color  vc  = w + l == 0 ? CL : pt >= 0 ? KWIN : KLOSS
    string zt  = z == 0 ? "No news close by." :
         z == 1 ? "Went live " + str.tostring(i_nwBef) + "–" + str.tostring(i_nwBef + i_nwPreLen) + " min BEFORE a news release." :
         z == 2 ? "Went live inside the no-trade window (" + str.tostring(i_nwBef) + " min before … " + str.tostring(i_nwAft) + " min after). " +
         (i_nwOn ? "Filter ON: new ❖ are skipped, so only pending orders that filled earlier appear here." : "Filter OFF: these trades were taken, so you can compare.") :
         "Went live " + str.tostring(i_nwAft) + "–" + str.tostring(i_nwAft + i_nwPostLen) + " min AFTER a news release (side effect zone)."
    string tip = zt + "\nBUY ❖:  " + str.tostring(wb) + "W " + str.tostring(lb) + "L" + f_wr(wb, lb) +
         "\nSELL ❖: " + str.tostring(w - wb) + "W " + str.tostring(l - lb) + "L" + f_wr(w - wb, l - lb) +
         "\nCounted where the trade went live · spread " + str.tostring(kM.spr, "0.00")
    f_dRow(r, kNwKey.get(z), v, CR, vc, size.tiny, tip)

// prop firm rows (picked spread)
float  kPfTgt    = i_pfAcc * (1 + (kM.phase == 1 ? i_pfT1 : i_pfT2) / 100)
float  kPfDayAmt = i_pfDay / 100 * math.min(kM.dayBal, i_pfAcc)
float  kPfMaxAmt = i_pfMax / 100 * i_pfAcc
float  kPfDayUse = math.max(kM.dayBal - kM.bal, 0.0)
float  kPfMaxUse = math.max(i_pfAcc - kM.bal, 0.0)
string kPfStr    = (kM.phase == 3 ? "FUNDED" : "Phase " + str.tostring(kM.phase)) + " · $" + str.tostring(kM.bal, "#,##0") +
     " (" + str.tostring((kM.bal / i_pfAcc - 1) * 100, "+0.0;-0.0") + "%)" +
     (kM.phase < 3 ? " · " + str.tostring(kM.phDays) + "/" + str.tostring(i_pfMinD) + " days" : "")
color  kPfCol    = kM.bal >= i_pfAcc ? KWIN : KLOSS
string kPfTip    = "Account $" + str.tostring(i_pfAcc, "#,##0") + " · " + str.tostring(i_pfLot) + " lot → WIN +$" + str.tostring(i_kTpPts * kUsdPt - kComm, "#,##0.##") +
     " · LOSS −$" + str.tostring(kRisk1, "#,##0.##") + " (" + str.tostring(kRisk1 / i_pfAcc * 100, "0.0#") + "% risk)" +
     (kM.phase < 3 ? "\nTarget: $" + str.tostring(kPfTgt, "#,##0") + " (" + str.tostring(math.max(kPfTgt - kM.bal, 0), "#,##0") + " to go) and " + str.tostring(i_pfMinD) + " trading days" :
     "\nFunded P&L so far (all funded accounts): $" + str.tostring(kM.fundPnl, "+#,##0;-#,##0"))
string kPfLimStr = "day −$" + str.tostring(kPfDayUse, "#,##0") + " / " + (i_pfDay > 0 ? str.tostring(kPfDayAmt, "#,##0") : "no limit") +
     " · max −$" + str.tostring(kPfMaxUse, "#,##0") + " / " + str.tostring(kPfMaxAmt, "#,##0")
color  kPfLimCol = (i_pfDay > 0 and kPfDayUse >= 0.6 * kPfDayAmt) or kPfMaxUse >= 0.6 * kPfMaxAmt ? color.orange : color.white
string kPfLimTip = (i_pfDay > 0 ? "Daily loss: from $" + str.tostring(kM.dayBal, "#,##0") + " at the start of today, limit $" + str.tostring(kPfDayAmt, "#,##0") :
     "Daily loss: no limit (Max daily loss % = 0)") +
     "\nMax loss: equity may not go below $" + str.tostring(i_pfAcc - kPfMaxAmt, "#,##0") +
     "\nBlock ❖ trades that could break a limit: " + (i_pfGuard ? "ON (buffer " + str.tostring(i_pfBuf) + "%)" : "OFF") +
     "\nClosed balance shown; open trades are checked at their worst price each candle"
string kPfResStr = "P1 ✓" + str.tostring(kM.p1Pass) + " · funded " + str.tostring(kM.funded) + " · ✗" + str.tostring(kM.fails + kM.fundFail) +
     (kM.stopped > 0 ? " · ⛔" + str.tostring(kM.stopped) : "") + (kM.blocked > 0 ? " · blocked " + str.tostring(kM.blocked) : "")
color  kPfResCol = kM.fails + kM.fundFail + kM.stopped == 0 ? KWIN : kM.funded > 0 ? color.orange : KLOSS
string kPfResTip = "Phase 1 passed: " + str.tostring(kM.p1Pass) + " · reached funded: " + str.tostring(kM.funded) +
     "\nFailed in Phase 1 / 2: " + str.tostring(kM.fails) + " · funded accounts lost: " + str.tostring(kM.fundFail) +
     "\n⛔ Stopped (max-loss room smaller than one trade, new Phase 1 started): " + str.tostring(kM.stopped) +
     "\n❖ blocked by the limits: " + str.tostring(kM.blocked) +
     "\nHedging rule (" + i_pfHedge + "): skipped / cancelled " + str.tostring(kM.hedgeSkip) + " · closed early " + str.tostring(kM.early) +
     "\nFunded P&L: $" + str.tostring(kM.fundPnl, "+#,##0;-#,##0") +
     (kPfLog.size() > 0 ? "\n\n" + kPfLog.join("\n") : "")

int    kDaysN  = math.max(kDaysAll, 1)
int    kFT     = nz(kFirstTm, kChartTm)
string kPerStr = (na(kFirstTm) ? "—" : str.format_time(kFT, "dd MMM yy") + " → " + str.format_time(time, "dd MMM yy") + " · " + str.tostring(kDaysN) + " days") +
     (kLtfOn ? " · ❖ " + i_ktrLtf : "")
string kPerTip = (na(kFirstTm) ? "No ❖ trade yet." :
     "From the first ❖ trade (" + str.format_time(kFT, "dd MMM yyyy HH:mm") + ") to now = " + str.tostring(kDaysN) + " trading days (daily candles)." +
     "\nAverage per day: " + str.tostring(kNetPts / kDaysN, "+#.#;-#.#") + " pts · " + str.tostring(kN * 1.0 / kDaysN, "#.#") + " trades") +
     "\nChart history starts " + str.format_time(kChartTm, "dd MMM yyyy") + ". TradingView only loads a limited number of candles, so a lower timeframe tests a shorter period." +
     (kLtfOn ? "\n❖ confirms on " + i_ktrLtf + " candles (diamond from the chart candles). " + i_ktrLtf + " data starts " +
     (na(kLtfFrom) ? "—" : str.format_time(kLtfFrom, "dd MMM yyyy HH:mm")) + " — no ❖ before that." :
     i_ktrLtf != "Off (chart candles)" ? "\n'Entry ❖ confirm on lower TF' = " + i_ktrLtf + ", but the chart is not higher than that → the chart candles are used." : "")
// average per trading day / week (week = 5 trading days)
float  kAvgPt  = kNetPts / kDaysN
float  kUsd001 = i_kPtVal * 100 * 0.01          // $ per pt at 0.01 lot (100 oz per lot)
string kAvgStr = str.tostring(kAvgPt, "+#;-#") + " pts · " + str.tostring(kWins * 1.0 / kDaysN, "0.0") + "W " +
     str.tostring(kLosses * 1.0 / kDaysN, "0.0") + "L · $" + str.tostring(kAvgPt * kUsd001, "+0.0;-0.0") + " /0.01 lot"
string kAvgTip = "Average over " + str.tostring(kDaysN) + " trading days (spread " + str.tostring(kM.spr, "0.00") + ")" +
     "\nPer day:  " + str.tostring(kAvgPt, "+#.#;-#.#") + " pts · " + str.tostring(kWins * 1.0 / kDaysN, "0.0") + " wins · " +
     str.tostring(kLosses * 1.0 / kDaysN, "0.0") + " losses · $" + str.tostring(kAvgPt * kUsd001, "+0.0#;-0.0#") + " per 0.01 lot" +
     "\nPer week: " + str.tostring(kAvgPt * 5, "+#;-#") + " pts · " + str.tostring(kWins * 5.0 / kDaysN, "0.0") + " wins · " +
     str.tostring(kLosses * 5.0 / kDaysN, "0.0") + " losses · $" + str.tostring(kAvgPt * 5 * kUsd001, "+0.0;-0.0") + " per 0.01 lot" +
     "\n$ scales with lot: 0.10 lot = ×10"
string kDayStr = str.tostring(kM.dayPts, "+#.##;-#.##") + " pts · " + str.tostring(kM.dayW) + "W " + str.tostring(kM.dayL) + "L" + (kDayBlock ? " · " + kM.dayWhy : "")
color  kDayCol = kM.dayPts > 0 ? KWIN : kM.dayPts < 0 ? KLOSS : CL
string kDayTip = (i_kDayOn ? "Daily limit ON: target +" + str.tostring(i_kDayTp, "#.##") + " · loss −" + str.tostring(i_kDaySl, "#.##") + " pts" :
     "Daily limit OFF (turn it on in ⓪b to test it)") +
     "\nDays that hit the target: " + str.tostring(kM.daysTgt) + " · hit the loss limit: " + str.tostring(kM.daysLoss) + " (of " + str.tostring(kDaysN) + " days)" +
     "\n❖ skipped / pending cancelled by the daily limit: " + str.tostring(kM.skipDay)
string kTpSlStr = "+" + kTpTxt + " / −" + kSlTxt + " pts · spread " + str.tostring(kM.spr, "0.00") + (i_kTpLon > 0 ? " · London TP +" + str.tostring(i_kTpLon) : "")
string kTpSlTip = "TP " + str.tostring(kTpDist, "#.##") + " · SL " + str.tostring(kSlDist, "#.##") + " in price  (1 pt = " + str.tostring(i_kPtVal) + ")"
string kEntStr = (kPendOn ? (kLimOn ? "LIMIT" : "STOP") + " ±" + kOffTxt + " pts · " + str.tostring(i_kExp) + " candles" + (kRunTxt == "" ? "" : " / " + kRunTxt + " pts") : "At ❖ close") +
     (i_kSkOn ? " · skip " + str.tostring(i_kSkM) + " after " + str.tostring(i_kSkN) + " SL" : "") +
     (kSes1 ? " · 1 per session" : kSesSlW ? " · SL → next session" : "")
string kEntTip = kPendOn ? (kLimOn ? "BUY at ❖ close − " + kOffTxt + " pts, SELL at ❖ close + " + kOffTxt + " pts" :
     "BUY at ❖ close + " + kOffTxt + " pts, SELL at ❖ close − " + kOffTxt + " pts") +
     " (= " + str.tostring(kOffDist, "#.##") + " in price).\nCounted only once price reaches it; missed after " + str.tostring(i_kExp) + " candles" +
     (kRunTxt == "" ? "." : " or when price runs " + kRunTxt + " pts away from it first.") :
     "Trade starts at the ❖ candle close (BUY on the ask = close + spread)." +
     (i_kSkOn ? "\nAfter " + str.tostring(i_kSkN) + " SL in a row the next " + str.tostring(i_kSkM) + " ❖ " + (i_kSkM == 1 ? "is" : "are") + " skipped" +
     (i_kSkDay ? " (count starts again each day)" : "") + " · skipped so far: " + str.tostring(kM.skN) : "") +
     (kSes1 ? "\nOnly the first ❖ of each session is traded" : kSesSlW ? "\nAfter an SL the rest of that session is skipped" : "") +
     (kSes1 or kSesSlW ? " · skipped / cancelled so far: " + str.tostring(kM.sesLimSk) : "")
// 📆 per month row
var array<string> kMoNm = array.from("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
float  kRefLot = 0.01
f_moRow(int r) =>
    int    nm   = kMoKey.size()
    float  tot  = 0.0
    int    pos  = 0
    float  best = na
    float  wrst = na
    string bN   = ""
    string wN   = ""
    string ls   = ""
    if nm > 0
        for i = nm - 1 to 0
            int    k  = kMoKey.get(i)
            float  pt = kMoPts.get(i)
            int    w  = kMoW.get(i)
            int    l  = kMoL.get(i)
            string mn = kMoNm.get(k % 12) + " " + str.tostring(math.floor(k / 12) % 100, "00")
            tot += pt
            pos += pt > 0 ? 1 : 0
            if na(best) or pt > best
                best := pt
                bN   := mn
            if na(wrst) or pt < wrst
                wrst := pt
                wN   := mn
            if nm - i <= 24
                ls += "\n" + mn + "   " + str.tostring(w) + "W " + str.tostring(l) + "L" + f_wr(w, l) +
                     " · " + str.tostring(pt, "+#;-#") + " pts (" + str.tostring(pt / i_kSlPts, "+#.#;-#.#") + "R)" +
                     " · $" + str.tostring(pt * kUsdLot1 * kRefLot, "+#,##0.##;-#,##0.##") +
                     (kMoTg.get(i) + kMoLs.get(i) > 0 ? " · 🎯" + str.tostring(kMoTg.get(i)) + " ⛔" + str.tostring(kMoLs.get(i)) : "") +
                     (kMoE.get(i) > 0 ? " · " + str.tostring(kMoE.get(i)) + " closed early" : "") +
                     " · " + str.tostring(kMoDay.get(i)) + " days"
    float  perMo = kNetPts / kDaysN * 21                // ≈ 21 trading days a month
    string v     = nm == 0 ? "—" : "≈ " + str.tostring(perMo, "+#;-#") + " pts · $" + str.tostring(perMo * kUsdLot1 * kRefLot, "+#,##0;-#,##0") +
         " /month (" + str.tostring(kRefLot, "0.00") + ") · " + str.tostring(pos) + " of " + str.tostring(nm) + " months +"
    string tip   = "Per month · spread " + str.tostring(kM.spr, "0.00") + " · $ at " + str.tostring(kRefLot, "0.00") + " lot (×10 for 0.10 lot)" +
         "\nAverage month (21 trading days): " + str.tostring(perMo, "+#;-#") + " pts (" + str.tostring(perMo / i_kSlPts, "+#.#;-#.#") + "R) · $" +
         str.tostring(perMo * kUsdLot1 * kRefLot, "+#,##0.##;-#,##0.##") +
         (nm > 0 ? "\nMonths in profit: " + str.tostring(pos) + " of " + str.tostring(nm) + " · best " + bN + " " + str.tostring(best, "+#;-#") +
         " pts · worst " + wN + " " + str.tostring(wrst, "+#;-#") + " pts" : "") +
         "\nThe first and the last month can be part months (see days). A trade counts in the month it closed." +
         (nm > 0 ? "\n" + ls : "")
    f_dRow(r, "📆 Per month", v, CH, perMo >= 0 ? KWIN : KLOSS, size.tiny, tip)

// 🧪 breakdown row: groups 0-2 type · 3-4 side · 5-8 session · 9-12 nth · 13-14 1H · 15-16 flow · 17-19 ADX · 20-23 location
var array<string> kBrkNm = array.from("Reversal ◇", "Continuation ◇", "Micro-pullback ◇", "BUY", "SELL",
     "Asia", "London", "New York", "Other hours", "1st ❖ of day", "2nd ❖", "3rd ❖", "4th+ ❖",
     "With 1H trend", "Against 1H trend", "Order flow with ❖", "Order flow against ❖",
     "ADX weak (ranging)", "ADX strong, ❖ with it", "ADX strong, ❖ against it",
     "Cheap: > 1 step past OP", "Cheap: 0–1 step", "Expensive: 0–1 step", "Expensive: > 1 step (chasing)")
f_brkTip() =>
    array<int>   w = array.new_int(24, 0)
    array<int>   l = array.new_int(24, 0)
    array<float> p = array.new_float(24, 0.0)
    int n = math.min(kTrCode.size(), kTrTyp.size())
    if n > 0
        for i = 0 to n - 1
            int c = kTrCode.get(i)
            if c == 1 or c == -1
                float pt  = kTrPts.get(i)
                int   nth = kTrNth.get(i)
                array<int> g = array.from(kTrTyp.get(i), kTrDir.get(i) == 1 ? 3 : 4, 5 + kTrSes.get(i), 9 + math.min(math.max(nth, 1), 4) - 1,
                     kTrHtf.get(i) == 1 ? 13 : kTrHtf.get(i) == -1 ? 14 : -1, kTrOf.get(i) == 1 ? 15 : 16, 17 + kTrAdx.get(i),
                     kTrLoc.get(i) >= 0 ? 20 + kTrLoc.get(i) : -1)
                for k in g
                    if k >= 0
                        w.set(k, w.get(k) + (c == 1 ? 1 : 0))
                        l.set(k, l.get(k) + (c == 1 ? 0 : 1))
                        p.set(k, p.get(k) + pt)
    string tip = "🧪 Breakdown of closed ❖ trades (WIN / LOSS) · spread " + str.tostring(kM.spr, "0.00") +
         " · break-even win rate " + str.tostring(i_kSlPts * 100.0 / (i_kTpPts + i_kSlPts), "#") + "%"
    array<string> hd = array.from("\n\n◇ DIAMOND TYPE", "\n\nSIDE", "\n\nSESSION (at the ❖)", "\n\n❖ OF THE DAY",
         "\n\n1H TREND", "\n\nORDER FLOW", "\n\nADX (" + str.tostring(i_kAdxMin) + ")", "\n\nLOCATION vs OP (KTR steps)")
    array<int>    st = array.from(0, 3, 5, 9, 13, 15, 17, 20)
    for k = 0 to 23
        int hi = st.indexof(k)
        if hi >= 0
            tip += hd.get(hi)
        int ww = w.get(k)
        int ll = l.get(k)
        if ww + ll > 0
            tip += "\n  " + kBrkNm.get(k) + ":  " + str.tostring(ww) + "W " + str.tostring(ll) + "L" + f_wr(ww, ll) +
                 " · " + str.tostring(p.get(k), "+#;-#") + " pts (" + str.tostring(p.get(k) / i_kSlPts, "+#.#;-#.#") + "R)"
    string v = "Rev " + str.tostring(w.get(0)) + "W " + str.tostring(l.get(0)) + "L" + f_wr(w.get(0), l.get(0)) +
         " · Cont " + str.tostring(w.get(1)) + "W " + str.tostring(l.get(1)) + "L" + f_wr(w.get(1), l.get(1)) +
         " · Micro " + str.tostring(w.get(2)) + "W " + str.tostring(l.get(2)) + "L" + f_wr(w.get(2), l.get(2))
    [v, tip]
f_brkRow(int r) =>
    [v, tip] = f_brkTip()
    f_dRow(r, "🧪 Breakdown", v, CH, CL, size.tiny, tip + "\n\nHover-only list; small groups (< 20 trades) are not reliable.")

// 🔬 filter report row
f_repTx(int st) =>
    str.tostring(kRepW.get(st)) + "W " + str.tostring(kRepL.get(st)) + "L" + f_wr(kRepW.get(st), kRepL.get(st)) + " · " + str.tostring(kRepP.get(st), "+#;-#") + " pts"
bool   kAnyFlt = i_kHtf != "Off" or i_kWick or i_kHold or i_kOfOn or i_kAdxOn
string kRepStr = not kAnyFlt ? "no ❖ filter on (⓪)" : kLtfOn ? "not with ❖ on lower TF" :
     "removed " + str.tostring(kRepW.get(2) + kRepL.get(2)) + ": " + str.tostring(kRepW.get(2)) + "W " + str.tostring(kRepL.get(2)) + "L · net " +
     str.tostring(kRepP.get(1) - kRepP.get(0), "+#;-#") + " pts vs v3"
var array<string> kFltNm = array.from("Higher-TF trend (" + i_kHtf + ")", "Rejection wick (" + str.tostring(i_kWickPct) + "%)",
     "Order flow / ADX", "Wait 1 candle")
string kRepTip = "Simple trade test for all ❖ (entry at the ❖ close, TP " + str.tostring(i_kTpPts, "#") + " / SL " + str.tostring(i_kSlPts, "#") +
     ", spread " + str.tostring(i_kSpr, "0.00") + ", no pending / limits) — compare these lines with each other, not with the main rows." +
     "\n\nv3 ❖ (no filters):  " + f_repTx(0) +
     "\nv4 ❖ (filters on):  " + f_repTx(1) +
     "\nDifference: " + str.tostring(kRepP.get(1) - kRepP.get(0), "+#;-#") + " pts (" + str.tostring((kRepP.get(1) - kRepP.get(0)) / i_kSlPts, "+#.#;-#.#") + "R)" +
     "\n\n❖ removed by the filters (at the moment they printed): " + f_repTx(2) +
     "\n→ mostly L = the filters remove bad ❖ (good) · mostly W = they remove good ❖ (bad)" +
     "\nA removed setup can still give a later v4 ❖ — that one is in the v4 line." +
     "\n\nPer filter (a ❖ can be removed by more than one):"
for k = 0 to 3
    kRepTip += "\n" + kFltNm.get(k) + ": " + str.tostring(kRepFN.get(k)) + " removed → " + str.tostring(kRepFW.get(k)) + "W " +
         str.tostring(kRepFL.get(k)) + "L" + f_wr(kRepFW.get(k), kRepFL.get(k))


// ❖ of the day rows (⓪i)
f_resTx(int code, float pts, bool full) =>
    code == 1 ? (full ? "WIN " : "W ") + str.tostring(pts, "+#;-#") :
     code == -1 ? (full ? "LOSS " : "L ") + str.tostring(pts, "+#;-#") :
     code == 0 ? (full ? "missed (not filled)" : "M") :
     code == 2 ? (full ? "closed early " : "C ") + str.tostring(pts, "+#;-#") :
     code == 3 ? "skip" : "open"
f_nthRow(int r, int sl) =>
    int    w   = kNthW.get(sl)
    int    l   = kNthL.get(sl)
    int    e   = kNthE.get(sl)
    int    m   = kNthM.get(sl)
    float  pt  = kNthPts.get(sl)
    int    n   = w + l + e
    string nm  = sl == 3 ? "4th+" : f_nthTxt(sl + 1)
    // only the first N ❖ each day = this slot and all before it
    int    cw  = 0
    int    cl  = 0
    int    ce  = 0
    float  cp  = 0.0
    for k = 0 to sl
        cw += kNthW.get(k)
        cl += kNthL.get(k)
        ce += kNthE.get(k)
        cp += kNthPts.get(k)
    string ls  = ""
    int    cnt = 0
    if kTrCode.size() > 0
        for i = kTrCode.size() - 1 to 0
            if cnt >= 25
                break
            int nth = kTrNth.get(i)
            if sl == 3 ? nth >= 4 : nth == sl + 1
                ls  += "\n" + str.format_time(kTrDay.get(i), "EEE dd MMM yy", "UTC") + "   " + (sl == 3 ? f_nthTxt(nth) + " " : "") + f_resTx(kTrCode.get(i), kTrPts.get(i), true)
                cnt += 1
    string v   = str.tostring(w) + "W " + str.tostring(l) + "L" + f_wr(w, l) + " · " + str.tostring(pt, "+#;-#") + " pts · avg " +
         (n > 0 ? str.tostring(pt / n, "+#;-#") : "—") + (m > 0 ? " · " + str.tostring(m) + " missed" : "")
    color  vc  = n == 0 ? CL : pt >= 0 ? KWIN : KLOSS
    string tip = "The " + nm + " ❖ trade of each day · spread " + str.tostring(kM.spr, "0.00") +
         "\n" + str.tostring(w) + " wins · " + str.tostring(l) + " losses" + f_wr(w, l) + (e > 0 ? " · " + str.tostring(e) + " closed early" : "") +
         " · " + str.tostring(m) + " missed (pending not filled, not counted)" +
         "\nAvg per trade: " + (n > 0 ? str.tostring(pt / n, "+#.#;-#.#") : "—") + " pts · per test day: " + str.tostring(pt / kDaysN, "+#.#;-#.#") + " pts (" + str.tostring(kDaysN) + " days)" +
         (sl > 0 and sl < 3 ? "\nOnly the first " + str.tostring(sl + 1) + " ❖ each day: " + str.tostring(cw) + "W " + str.tostring(cl) + "L" + f_wr(cw, cl) +
         " · " + str.tostring(cp, "+#;-#") + " pts · " + str.tostring(cp / kDaysN, "+#.#;-#.#") + " pts / day" : "") +
         (sl == 0 ? "\nOnly the 1st ❖ each day: " + str.tostring(cp / kDaysN, "+#.#;-#.#") + " pts / day" : "") +
         (cnt > 0 ? "\n\nLatest (newest first):" + ls : "\nNo trade yet.")
    f_dRow(r, "❖ " + nm + " of day", v, CR, vc, size.tiny, tip)
// day after a ⛔ / 🎯 day: 1st, 2nd and 3rd ❖ of that day + patterns (1st L and 2nd L → 3rd?)
f_aftDay(array<int> pat, int c1, int c2, int c3) =>
    // pat: [WW, WL, LW, LL, LL→3rd W, LL→3rd L, LL→no 3rd]
    if c1 == 1 or c1 == -1
        if c2 == 1 or c2 == -1
            int k = (c1 == 1 ? 0 : 2) + (c2 == 1 ? 0 : 1)
            pat.set(k, pat.get(k) + 1)
            if k == 3
                int j = c3 == 1 ? 4 : c3 == -1 ? 5 : 6
                pat.set(j, pat.get(j) + 1)
    pat
f_aftRow(int r, int typ) =>
    array<int>   w   = array.new_int(3, 0)
    array<int>   l   = array.new_int(3, 0)
    array<int>   m   = array.new_int(3, 0)
    array<float> pt  = array.new_float(3, 0.0)
    array<int>   pat = array.new_int(7, 0)
    int    nd   = 0
    int    last = -1
    int    c1   = 9
    int    c2   = 9
    int    c3   = 9
    string ls   = ""
    string dayS = ""
    int    n    = kTrCode.size()
    if n > 0
        for i = n - 1 to 0
            int nth = kTrNth.get(i)
            if kTrPrev.get(i) == typ and nth >= 1 and nth <= 3
                int c = kTrCode.get(i)
                int s = nth - 1
                if c == 1
                    w.set(s, w.get(s) + 1)
                else if c == -1
                    l.set(s, l.get(s) + 1)
                else if c == 0
                    m.set(s, m.get(s) + 1)
                pt.set(s, pt.get(s) + kTrPts.get(i))
                int d = kTrDay.get(i)
                if d != last
                    if nd > 0
                        f_aftDay(pat, c1, c2, c3)
                        if nd <= 25
                            ls += "\n" + str.format_time(last, "EEE dd MMM yy", "UTC") + "   " + dayS
                    nd   += 1
                    last := d
                    dayS := ""
                    c1   := 9
                    c2   := 9
                    c3   := 9
                if nth == 1
                    c1 := c
                else if nth == 2
                    c2 := c
                else
                    c3 := c
                // newest first → put the earlier ❖ of the day in front (1st · 2nd · 3rd)
                dayS := f_nthTxt(nth) + " " + f_resTx(c, kTrPts.get(i), false) + (dayS == "" ? "" : "  ·  " + dayS)
        if nd > 0
            f_aftDay(pat, c1, c2, c3)
            if nd <= 25
                ls += "\n" + str.format_time(last, "EEE dd MMM yy", "UTC") + "   " + dayS
    string v   = "1st " + str.tostring(w.get(0)) + "W " + str.tostring(l.get(0)) + "L" + f_wr(w.get(0), l.get(0)) +
         " · 2nd " + str.tostring(w.get(1)) + "W " + str.tostring(l.get(1)) + "L" + f_wr(w.get(1), l.get(1)) +
         " · 3rd " + str.tostring(w.get(2)) + "W " + str.tostring(l.get(2)) + "L" + f_wr(w.get(2), l.get(2)) +
         " · L+L " + str.tostring(pat.get(3)) + "×"
    float  tp  = pt.get(0) + pt.get(1) + pt.get(2)
    string nmT = typ == 1 ? "⛔ loss-limit" : "🎯 target"
    string tip = "The day after a " + nmT + " day (" + str.tostring(nd) + " days) · spread " + str.tostring(kM.spr, "0.00")
    for k = 0 to 2
        tip += "\n" + f_nthTxt(k + 1) + " ❖: " + str.tostring(w.get(k)) + "W " + str.tostring(l.get(k)) + "L" + f_wr(w.get(k), l.get(k)) +
             " · " + str.tostring(pt.get(k), "+#;-#") + " pts" + (m.get(k) > 0 ? " · " + str.tostring(m.get(k)) + " missed" : "") +
             " · all days: " + str.tostring(kNthW.get(k)) + "W " + str.tostring(kNthL.get(k)) + "L" + f_wr(kNthW.get(k), kNthL.get(k))
    tip += "\n1st + 2nd + 3rd: " + str.tostring(tp, "+#;-#") + " pts" + (nd > 0 ? " · " + str.tostring(tp / nd, "+#.#;-#.#") + " pts per such day" : "") +
         "\n\n1st and 2nd (days with both closed W / L):" +
         "\n  1st W · 2nd W: " + str.tostring(pat.get(0)) + " days" +
         "\n  1st W · 2nd L: " + str.tostring(pat.get(1)) + " days" +
         "\n  1st L · 2nd W: " + str.tostring(pat.get(2)) + " days" +
         "\n  1st L · 2nd L: " + str.tostring(pat.get(3)) + " days  →  3rd ❖ then: " + str.tostring(pat.get(4)) + "W " +
         str.tostring(pat.get(5)) + "L" + f_wr(pat.get(4), pat.get(5)) + (pat.get(6) > 0 ? " · no 3rd trade " + str.tostring(pat.get(6)) + "×" : "") +
         (i_kDayOn ? "\n(daily limit −" + str.tostring(i_kDaySl, "#") + " pts can stop the day before a 3rd ❖)" : "\n⚠ Daily limit is OFF in ⓪b → there are no ⛔ / 🎯 days.") +
         (nd > 0 ? "\n\nLatest (newest first):" + ls : "")
    f_dRow(r, (typ == 1 ? "⛔" : "🎯") + " → next day", v, CR, nd == 0 ? CL : tp >= 0 ? KWIN : KLOSS, size.tiny, tip)

f_dayLog(int r) =>
    string v   = "—"
    string tip = ""
    int    nd  = 0
    int    i   = kTrCode.size() - 1
    while i >= 0 and nd < 30
        int    d    = kTrDay.get(i)
        string full = ""
        string shrt = ""
        float  dp   = 0.0
        while i >= 0
            if kTrDay.get(i) != d
                break
            full := (kTrNth.get(i) > 0 ? f_nthTxt(kTrNth.get(i)) + " " : "") + f_resTx(kTrCode.get(i), kTrPts.get(i), false) + (full == "" ? "" : " · " + full)
            shrt := f_resTx(kTrCode.get(i), kTrPts.get(i), false) + (shrt == "" ? "" : " · " + shrt)
            dp   += kTrPts.get(i)
            i    -= 1
        string dt = str.format_time(d, "EEE dd MMM", "UTC")
        if nd == 0
            v := dt + ": " + shrt + " = " + str.tostring(dp, "+#;-#") + " pts"
        tip := tip + "\n" + dt + "   " + full + "   = " + str.tostring(dp, "+#;-#") + " pts"
        nd  += 1
    f_dRow(r, "📅 Day log", v, CR, CL, size.tiny, "❖ trades per day, newest first (last " + str.tostring(nd) + " days with a ❖ trade) · spread " +
         str.tostring(kM.spr, "0.00") + "\nW = win · L = loss · M = missed (pending not filled) · C = closed early · open = still running · skip = ❖ skipped after SL in a row" + tip)

if barstate.islast and i_showDash
    int r = 0
    r := f_dRow(r, "KTR", syminfo.ticker, CH, color.white, size.small, "")
    r := f_dRow(r, "KTR", kStr, CH, kCol, size.small, "")
    if kTrack
        r := f_dRow(r, "❖ Win / Loss", kWLStr,  CH, kWLCol,   size.small, kWLTip)
        r := f_dRow(r, "❖ Net",        kNetStr, CH, kWLCol,   size.small, kNetTip)
        if i_nwTop
            r := f_nwRow(r, 3)          // 📰 After news — kept near the top so it is never cut off
        if i_kSprCmp
            for sc = 0 to kSt.size() - 1
                r := f_sprRow(r, sc)
        if i_sesOn
            r := f_sesRow(r, 0, f_sesHrs(i_sesAsia))
            r := f_sesRow(r, 1, f_sesHrs(i_sesLon))
            r := f_sesRow(r, 2, f_sesHrs(i_sesNy))
            if kSesW.get(3) + kSesL.get(3) + kSesSkip.get(3) > 0 or not i_sesOOn
                r := f_sesRow(r, 3, "outside the 3 sessions")
        if i_nthOn
            for sl = 0 to 3
                if sl < 3 or kNthW.get(3) + kNthL.get(3) + kNthM.get(3) + kNthE.get(3) > 0
                    r := f_nthRow(r, sl)
        if i_brkOn
            r := f_brkRow(r)
        if i_repOn
            r := f_dRow(r, "🔬 Filters", kRepStr, CH, kRepP.get(1) >= kRepP.get(0) ? KWIN : KLOSS, size.tiny, kRepTip)
        if i_aftOn
            r := f_aftRow(r, 1)
            r := f_aftRow(r, 2)
        if i_nthLog
            r := f_dayLog(r)
        if i_wdOn
            for i = 0 to 4
                r := f_wdRow(r, i)
        if i_rowWk
            r := f_wkRow(r)
            r := f_lwRow(r)
        if i_rowWdSum
            r := f_wdSum(r)
        if i_mwOn
            for k = 0 to kMwN - 1
                r := f_mwRow(r, k)
        if i_mwSum
            r := f_mwSum(r)
        if i_nwNext
            r := f_nwStatusRow(r)
        if i_nwStat
            for z = 0 to 2
                r := f_nwRow(r, z)
        if i_pfOn
            r := f_dRow(r, "🏦 Account", kPfStr,    CH, kPfCol,    size.tiny, kPfTip)
            r := f_dRow(r, "🏦 Limits",  kPfLimStr, CH, kPfLimCol, size.tiny, kPfLimTip)
            r := f_dRow(r, "🏦 Results", kPfResStr, CH, kPfResCol, size.tiny, kPfResTip)
        r := f_dRow(r, "❖ Period",     kPerStr, CH, color.white, size.tiny, kPerTip)
        r := f_dRow(r, "❖ Avg / day",  kAvgStr, CH, kNetPts >= 0 ? KWIN : KLOSS, size.tiny, kAvgTip)
        if i_moOn
            r := f_moRow(r)
        r := f_dRow(r, "❖ Entry",      kEntStr, CR, color.new(#FFC107,0), size.tiny, kEntTip)
        r := f_dRow(r, "❖ TP / SL",    kTpSlStr, CR, color.new(#FFC107,0), size.tiny, kTpSlTip)
        r := f_dRow(r, "❖ Today",      kDayStr, CR, kDayCol, size.tiny, kDayTip)
        r := f_dRow(r, "❖ Last",       kM.lastTxt, CR, na(kM.lastCol) ? CL : kM.lastCol, size.tiny, "")
    r := f_dRow(r, "Price", str.tostring(close,"#.00000"), CH, color.white, size.small, "")


// ══════════════════════════════════════════════════════════════════
// SECTION 17 — PANE: BOYS (above 0) + BULLISHNESS (below 0)
// This script runs as a pane script; everything above is forced onto
// the price chart. Tables (dashboard, BTC) render in this pane —
// drag the pane taller if they look squeezed.
// ══════════════════════════════════════════════════════════════════
paneRelVol = volume / ta.sma(volume, i_volLen) * 100
plot(paneRelVol, "Boys", style=plot.style_columns,
     color=close >= open ? color.green : color.red)

paneSigned = close > open ? volume : close < open ? -volume : 0.0
paneNet    = math.sum(paneSigned, i_bullLen)
panePress  = paneNet / ta.sma(volume, 100) * 50
paneExt    = panePress < ta.lowest(panePress, 200) * 0.75
plot(panePress < 0 ? panePress : na, "Bullishness",
     style=plot.style_columns,
     color=paneExt ? color.lime : color.blue)

hline(0, "Zero", color=color.gray)

var table tPaneTop = table.new(position.top_left, 1, 1)
var table tPaneBot = table.new(position.bottom_left, 1, 1)
if barstate.islast
    table.cell(tPaneTop, 0, 0, ktrUp ? "BOYS BUYING" : "BOYS SELLING",
         text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.black, 100))
    table.cell(tPaneBot, 0, 0, ktrUp ? "BULLISHNESS" : "BEARISHNESS",
         text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.black, 100))

// 📋 summary report in Pine Logs (once, on the last historical candle)
if i_sumLog and barstate.islastconfirmedhistory
    [bv, bt] = f_brkTip()
    string fl = "HTF " + i_kHtf + (i_kWick ? " · wick " + str.tostring(i_kWickPct) + "%" : "") + (i_kHold ? " · wait 1 candle" : "") +
         (i_kOfOn ? " · order flow " + str.tostring(i_kOfMin) + "%" : "") + (i_kAdxOn ? " · ADX " + str.tostring(i_kAdxMin) : "") +
         " · types " + (i_tRev ? "R" : "-") + (i_tCon ? "C" : "-") + (i_tMic ? "M" : "-") + " · BE " + (i_kBeOn ? str.tostring(i_kBePts, "#") + "+" + str.tostring(i_kBeLock, "#") : "off") +
         " · skip after SL " + (i_kSkOn ? str.tostring(i_kSkN) + "/" + str.tostring(i_kSkM) : "off") + " · per session " + i_kSesLim
    string mo = ""
    for i = 0 to math.max(kMoKey.size() - 1, 0)
        if i >= kMoKey.size()
            break
        int k = kMoKey.get(i)
        mo += "\n" + kMoNm.get(k % 12) + " " + str.tostring(math.floor(k / 12) % 100, "00") + ": " + str.tostring(kMoW.get(i)) + "W " +
             str.tostring(kMoL.get(i)) + "L · " + str.tostring(kMoPts.get(i), "+#;-#") + " pts · 🎯" + str.tostring(kMoTg.get(i)) + " ⛔" + str.tostring(kMoLs.get(i))
    string rep = "=== KTR v4 SUMMARY · " + syminfo.ticker + " " + timeframe.period + " · " + kPerStr + " ===" +
         "\nEntry: " + kEntStr + " · " + kTpSlStr + " · daily limit " + (i_kDayOn ? "+" + str.tostring(i_kDayTp, "#") + "/-" + str.tostring(i_kDaySl, "#") : "off") +
         "\nFilters: " + fl + "\nWin/Loss: " + kWLStr + "\nNet: " + kNetStr + "\nAvg/day: " + kAvgStr +
         "\n" + bt + "\n\n🔬 FILTERS: " + kRepStr + "\n" + kRepTip + "\n\n📆 MONTHS" + mo + "\n=== END ==="
    for ln in str.split(rep, "\n")
        if str.length(ln) > 0
            log.info(ln)
